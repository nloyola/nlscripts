#!/usr/bin/env bash
# A different random wallpaper on every monitor at login, dealt from the
# wallpapers the CURRENT DESKTOP THEME owns. Run from the session autostart -
# i3/autostart.sh under i3, an exec-once under Hyprland.
#
# A theme is a named palette (~/.config/theme) that carries a curated list of
# wallpapers chosen to suit it, the way an Omarchy theme ships a backgrounds/
# folder. So the login deal is not "any image under ~/wallpapers/library" any
# more: it is that theme's list, and the desktop stays coherent across a
# reboot instead of pairing a rose palette with whatever turned up.
#
# The dealing itself lives in qs-wallpaper rather than here: it is the same
# code path the quickshell display chip and the SUPER+SHIFT+W picker use to set
# one monitor, so a login and a hand pick agree on which wallpaper is on which
# output. Doing it with a bare `feh --bg-fill a b` here would leave that record
# stale and the chip naming files that are no longer on screen. It is also what
# makes this work under both sessions without a word about either: qs-wallpaper
# knows which of feh and the quickshell background surfaces paints, and this
# script never needs to.
#
# WHY NOT JUST `qs-theme set <current>`: that would re-render every config and
# reload every app at login for a palette that has not changed. The generated
# files in ~/.local/state/theme survive a reboot, so at login the only thing
# left to do is deal.
#
# This used to end by building a pywal palette from the first wallpaper. That
# branch is gone: nothing is derived from an image any more (the theme decides
# the colours and the wallpaper follows), and `wal` was never installed here,
# so it had been dead code guarded by a `command -v` for its whole life.

THEME=${QS_THEME_BIN:-$HOME/.local/bin/qs-theme}
WALLPAPER=${QS_WALLPAPER_BIN:-$HOME/.local/bin/qs-wallpaper}
THEME_DIR=${QS_THEME_DIR:-$HOME/.config/theme}

name=$("$THEME" current 2>/dev/null)
list=$THEME_DIR/themes/$name/wallpapers

# The pool: one glob or path per line, # comments and blanks ignored, ~
# expanded. IFS is newline only so a path with spaces in it survives a line
# with no glob characters, while a glob's matches still come out as separate
# words.
#
# STILL IMAGES ONLY. A theme's backgrounds/ is whatever its package shipped,
# and an Omarchy package may ship video wallpapers beside the stills -
# event-horizon carries six .mp4/.webm among sixteen files. Nothing in this
# desktop paints a video: the bar draws the state file's path into an Image,
# so dealing one puts a black screen on that monitor and no error anywhere.
# The glob in the theme's list cannot express the difference - it is one
# `event-horizon-*` line - so the filter has to be here, on the same
# extensions `qs-wallpaper random` deals from, the sibling of this pass.
pool=()
if [ -r "$list" ]; then
    while IFS= read -r line; do
        case $line in ''|\#*) continue ;; esac
        case $line in "~/"*) line=$HOME/${line#\~/} ;; esac
        for f in $line; do
            [ -f "$f" ] || continue
            case ${f##*.} in
                jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP) pool+=("$f") ;;
            esac
        done
    done < "$list"
fi

# No theme list, every file in it has moved, or the theme ships nothing but
# video: leave the wallpapers alone rather than dealing something off-theme.
# The remembered ones are already on screen (X11 restores them from ~/.fehbg,
# Wayland from the state file).
[ ${#pool[@]} -gt 0 ] || exit 0

# Shuffled once and dealt out, so two monitors never land on the same image
# unless the theme's list holds fewer than there are monitors.
mapfile -t shuffled < <(printf '%s\n' "${pool[@]}" | shuf)

# One name per enabled monitor, in the compositor's own order. qs-wallpaper is
# the only thing here that knows how to ask - xrandr under X11, hyprctl under
# Hyprland - so its `list` output is what supplies them.
mapfile -t outputs < <("$WALLPAPER" list 2>/dev/null |
                       tr ',' '\n' | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')

i=0
for out in "${outputs[@]}"; do
    "$WALLPAPER" set "$out" "${shuffled[i % ${#shuffled[@]}]}" >/dev/null || exit 1
    i=$((i + 1))
done
