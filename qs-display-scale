#!/bin/sh
# Per-monitor display scaling for the quickshell scale chip.
#
#   qs-display-scale list
#       Emit one JSON line describing every connected, enabled output:
#
#         {"outputs":[{"name":"DP-0","primary":true,"mode":"3840x2160",
#                      "logical":"1920x1080","w":1920,"h":1080,
#                      "x":0,"y":0,"factor":2.000}]}
#
#   qs-display-scale set <output> <factor>
#       Scale <output> so the desktop is magnified <factor> times, then
#       re-pack the outputs so the new logical size does not leave them
#       overlapping or gapped.
#
# `factor` is UI magnification: 2 means everything is twice as big, i.e. a 4K
# panel renders a 1920x1080 desktop. Nothing is persisted - the current factor
# is derived from the compositor itself, so the chip always reports what is
# actually on screen.
#
# TWO BACKENDS. Under Hyprland this drives `hyprctl keyword monitor`; under an
# X session it drives xrandr. The split is not cosmetic: XWayland answers
# `xrandr --query` (so `list` looked fine) but rejects RRSetScreenSize with
# BadMatch, so the xrandr-only version of this script was a silent no-op for
# every Hyprland session - the chip drew the presets and clicking one did
# nothing. XWayland also reports the outputs in its own left-to-right order,
# which need not be Hyprland's, so even the geometry it did report was wrong.
#
# HYPRLAND ROUNDING. Hyprland quantizes every scale to a multiple of 1/120
# (the wl_output scale-120 protocol) and then insists the logical size be
# integral on BOTH axes. So the accepted scales for a mode are exactly k/120
# for those k dividing both mode_w*120 and mode_h*120 - on 3840x2160, k must
# divide 28800. Hyprland will snap an invalid scale to the nearest such k
# itself, silently, which would leave the re-pack below computing positions
# from a scale that is not the one in force. So we run the same search up
# front and pass k/120 exactly, and `list` snaps the same way to recover the
# true logical size from the two decimals hyprctl prints.
#
# XRANDR ROUNDING. The framebuffer size is set with `--scale-from` rather than
# `--scale` so the rounding is ours: non-integer factors are rounded down to an
# even pixel count instead of whatever xrandr's own rounding produces.
# Untouched outputs keep their exact current framebuffer size, so repeated
# `set` calls cannot make a rounded factor drift.
#
# HYPRMONCFG. Where hyprmoncfg is installed and a profile is active, `set`
# writes the new scale and the re-packed positions INTO that profile and calls
# `hyprmoncfg apply`, rather than driving hyprctl itself.
#
# This is not a preference. hyprmoncfgd polls the compositor and re-applies the
# profile matching the monitors present, and its MonitorStateHash includes
# scale and position - so a bare `hyprctl keyword monitor` is seen as drift and
# reverted within a poll interval, silently, a second or so after the click.
# Going through the profile means the daemon's next poll finds exactly the
# state it would have applied, and reverts nothing. `hyprmoncfg apply` also
# takes the daemon's writer session, so there is one writer rather than two.
#
# The side effect is that the scale now SURVIVES A RELOAD, which it never did:
# it is in the profile, and the profile is what the generated monitor config is
# rendered from. It also means a scale change is a change to a tracked file -
# the profiles live in home_config - which is the same deal a `hyprmoncfg save`
# is on.
#
# The plain hyprctl path below is kept as the fallback for a host that has no
# hyprmoncfg or no active profile, where nothing is persisted and a
# `hyprctl reload` drops the scale as it always did.
#
# POINTER SPEED. Hyprland moves the cursor in logical coordinates, so the same
# hand motion crosses a scaled output in fewer logical pixels but the same
# physical distance on glass - at scale 2 the pointer visibly flies. `set`
# therefore also writes input:sensitivity, libinput's accel speed, as
# 1/scale - 1 (scale 1 -> 0, Hyprland's own default; 1.5 -> -0.333; 2 -> -0.5),
# which holds hand-distance-per-inch-of-screen roughly constant. Roughly: the
# adaptive accel profile is not linear in this value, so the correction is
# right in direction and about right in size, not literal. Sensitivity is
# global while scale is per-output, so it follows the output just scaled - the
# one being looked at. Sensitivity is not part of a monitor profile and is
# never persisted, so a `hyprctl reload` drops it back to hyprland.conf's
# default whichever backend applied the scale.
#
# RE-PACK ANCHOR. Changing an output's scale changes its logical width, so the
# outputs beside it have to move for the row to stay flush - and every window
# on a moved output moves with it. The anchor decides which windows suffer
# that. Packing from the origin, as this did originally, holds the leftmost
# output still and shifts everything to its right: scaling the left head threw
# the untouched right head's windows sideways, which is exactly the surprise.
# So the target is anchored on one of its own edges instead and the row packed
# outward from there: pin its right edge and every output to its right keeps
# its position while those to its left follow it; pin its left edge and the
# mirror holds. The edge chosen is the one facing the side with more outputs
# on it, so the larger group is the one that holds still. With two heads that
# means neither neighbour ever moves - scaling the left head moves only the
# left head, scaling the right head only the right - and the head that does
# move is the one being looked at, whose contents are being resized anyway. A
# middle head in a three-wide row has no free side, so there the smaller group
# gives way. The anchor is the layout on screen, not the requested factor, so
# scaling up and back down returns every output to where it started.
#
# An output can end up at a negative x (grow the leftmost head and it extends
# past the origin). Hyprland places monitors at negative coordinates happily,
# and normalising the row back to x=0 would move the very outputs this is
# meant to hold still, so the negative is kept.
#
# Outputs are re-packed horizontally in their current left-to-right order,
# each keeping its current y. A stacked (vertical) layout is not preserved.
#
# The X output with the framebuffer at the origin is the one xrandr marks
# primary; Hyprland has no such concept, so there the origin itself is what
# "primary" reports.
#
# QS_DISPLAY_SCALE_QUERY names a file to read instead of running xrandr, and
# QS_DISPLAY_SCALE_HYPR_QUERY does the same for `hyprctl monitors`;
# QS_DISPLAY_SCALE_DRY=1 prints the command instead of running it, so both
# parsing and layout can be driven from fixtures. Setting either QUERY var
# also picks that backend, whatever session the fixture is run from.
# QS_DISPLAY_SCALE_NO_HMC=1 forces the plain hyprctl path even where hyprmoncfg
# is installed and active, which is what a fixture run wants.

usage() {
    echo "usage: qs-display-scale list | set <output> <factor>" >&2
    exit 2
}

# Which compositor is in charge. The fixture vars win so a test can exercise
# either backend from any session.
use_hypr() {
    [ -n "$QS_DISPLAY_SCALE_HYPR_QUERY" ] && return 0
    [ -n "$QS_DISPLAY_SCALE_QUERY" ] && return 1
    [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && command -v hyprctl >/dev/null 2>&1
}

query() {
    if [ -n "$QS_DISPLAY_SCALE_QUERY" ]; then
        cat "$QS_DISPLAY_SCALE_QUERY"
    else
        xrandr --query 2>/dev/null
    fi
}

query_hypr() {
    if [ -n "$QS_DISPLAY_SCALE_HYPR_QUERY" ]; then
        cat "$QS_DISPLAY_SCALE_HYPR_QUERY"
    else
        hyprctl monitors 2>/dev/null
    fi
}

# Parse `xrandr --query` into one TSV row per connected, enabled output:
#
#   name  primary  mode_w  mode_h  fb_w  fb_h  x  y
#
# The output line carries the framebuffer geometry ("3840x2160+0+0"); the
# panel's own resolution is the mode line marked with "*". Connected outputs
# that are switched off have no geometry and are skipped, as is any output
# whose current mode xrandr did not report.
parse() {
    awk '
      function emit() {
          if (name != "" && fbw > 0 && modew > 0)
              printf "%s\t%s\t%d\t%d\t%d\t%d\t%d\t%d\n",
                     name, prim, modew, modeh, fbw, fbh, x, y
          name = ""
      }
      /^[^[:space:]]/ {
          emit()
          fbw = 0; fbh = 0; x = 0; y = 0; modew = 0; modeh = 0
          if ($2 != "connected") next
          name = $1
          prim = ($3 == "primary") ? "true" : "false"
          for (i = 3; i <= NF; i++)
              if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
                  split($i, g, /[x+]/)
                  fbw = g[1]; fbh = g[2]; x = g[3]; y = g[4]
                  break
              }
          next
      }
      # First mode line carrying "*" is the current one.
      name != "" && modew == 0 && /\*/ {
          split($1, m, "x")
          modew = m[1]; modeh = m[2]
      }
      END { emit() }
    '
}

# Parse `hyprctl monitors` into one TSV row per enabled monitor:
#
#   name  primary  mode_w  mode_h  refresh  x  y  scale  transform
#
# The first indented line of each block is "3840x2160@59.99700 at 3840x0"; the
# rest are "key: value". A monitor at the origin is reported primary, Hyprland
# having no primary of its own.
parse_hypr() {
    awk '
      function emit() {
          if (name != "" && !disabled && modew > 0)
              printf "%s\t%s\t%d\t%d\t%s\t%d\t%d\t%.6f\t%d\n",
                     name, (x == 0 && y == 0) ? "true" : "false",
                     modew, modeh, rr, x, y, scale, tr
          name = ""
      }
      /^Monitor / {
          emit()
          name = $2; disabled = 0
          modew = 0; modeh = 0; rr = ""; x = 0; y = 0; scale = 1; tr = 0
          next
      }
      name == "" { next }
      modew == 0 && $1 ~ /^[0-9]+x[0-9]+@/ {
          split($1, a, "@"); rr = a[2]
          split(a[1], m, "x"); modew = m[1]; modeh = m[2]
          split($3, p, "x"); x = p[1]; y = p[2]
          next
      }
      $1 == "scale:"     { scale = $2; next }
      $1 == "transform:" { tr = $2; next }
      $1 == "disabled:"  { disabled = ($2 == "true"); next }
      END { emit() }
    '
}

# Shared by both hyprctl paths: the scale-120 numerator nearest f*120 that
# Hyprland will actually accept for a w x h mode. Walks outward from the ideal
# so the answer is always the closest valid scale, and falls back to 1x rather
# than looping forever on a degenerate mode.
HYPR_SCALE120='
  function hypr_k(w, h, f,   base, d, c) {
      if (f <= 0) return 120
      base = int(f * 120 + 0.5)
      if (base < 1) base = 1
      for (d = 0; d <= 120 * 120; d++) {
          c = base - d; if (c >= 1 && (w * 120) % c == 0 && (h * 120) % c == 0) return c
          c = base + d; if ((w * 120) % c == 0 && (h * 120) % c == 0) return c
      }
      return 120
  }
'

cmd_list() {
    query | parse | awk '
      BEGIN { printf "{\"outputs\":[" }
      {
          if (n++) printf ","
          printf "{\"name\":\"%s\",\"primary\":%s,\"mode\":\"%dx%d\",", $1, $2, $3, $4
          printf "\"logical\":\"%dx%d\",\"w\":%d,\"h\":%d,", $5, $6, $5, $6
          printf "\"x\":%d,\"y\":%d,\"factor\":%.3f}", $7, $8, $3 / $5
      }
      END { printf "]}\n" }
    '
}

cmd_list_hypr() {
    query_hypr | parse_hypr | awk "$HYPR_SCALE120"'
      BEGIN { printf "{\"outputs\":[" }
      {
          w = $3; h = $4; tr = $9
          k = hypr_k(w, h, $8); lw = w * 120 / k; lh = h * 120 / k
          # A rotated monitor occupies its logical size the other way round.
          ow = lw; oh = lh
          if (tr % 2 == 1) { ow = lh; oh = lw }
          if (n++) printf ","
          printf "{\"name\":\"%s\",\"primary\":%s,\"mode\":\"%dx%d\",", $1, $2, w, h
          printf "\"logical\":\"%dx%d\",\"w\":%d,\"h\":%d,", ow, oh, ow, oh
          printf "\"x\":%d,\"y\":%d,\"factor\":%.3f}", $6, $7, k / 120
      }
      END { printf "]}\n" }
    '
}

check_factor() {
    case $1 in
        *[!0-9.]* | '' | .) echo "qs-display-scale: bad factor: $1" >&2; exit 2 ;;
    esac
}

cmd_set() {
    target=$1
    factor=$2
    [ -n "$target" ] && [ -n "$factor" ] || usage
    check_factor "$factor"

    args=$(query | parse | sort -t "$(printf '\t')" -k7,7n | awk -v target="$target" -v factor="$factor" '
      function even(v) { v = int(v); if (v % 2) v--; return (v < 2) ? 2 : v }
      {
          # Untouched outputs keep their exact framebuffer, so re-packing
          # never nudges an already-rounded factor.
          w = $5; h = $6
          if ($1 == target) { found = 1; w = even($3 / factor); h = even($4 / factor) }
          printf " --output %s --scale-from %dx%d --pos %dx%d", $1, w, h, x, $8
          x += w
      }
      END { if (!found) exit 3 }
    ') || { echo "qs-display-scale: no such enabled output: $target" >&2; exit 3; }

    [ -n "$args" ] || { echo "qs-display-scale: no enabled outputs" >&2; exit 3; }

    if [ "$QS_DISPLAY_SCALE_DRY" = 1 ]; then
        echo "xrandr$args"
    else
        # shellcheck disable=SC2086  # args is a built argument list
        xrandr $args
    fi
}

# The active hyprmoncfg profile, or nothing.
#
# `hyprmoncfg status` prints "Active profile: <name>", or "custom layout" when
# the live geometry matches no saved profile. Deliberately the human output and
# not `--json`: this is one field, and parsing a line beats taking a jq
# dependency for it. (jq IS used below, to patch the profile itself, where
# there is no honest alternative.)
hmc_profile() {
    [ "$QS_DISPLAY_SCALE_NO_HMC" = 1 ] && return 1
    command -v hyprmoncfg >/dev/null 2>&1 || return 1
    name=$(hyprmoncfg status 2>/dev/null |
           awk -F': ' '/^Active profile: /{ print $2; exit }')
    [ -n "$name" ] && [ "$name" != "custom layout" ] || return 1
    printf '%s\n' "$name"
}

# hyprmoncfg slugifies a profile name to get its filename: lowercased, every
# run of anything but [a-z0-9] collapsed to a single dash, dashes trimmed off
# both ends. Same rule as its internal/profile/store.go.
hmc_profile_path() {
    slug=$(printf '%s' "$1" |
        awk '{ s = tolower($0); gsub(/[^a-z0-9]+/, "-", s); gsub(/^-+|-+$/, "", s); print s }')
    printf '%s/hyprmoncfg/profiles/%s.json\n' \
           "${XDG_CONFIG_HOME:-$HOME/.config}" "$slug"
}

# Write the planned scale and position of every output into the profile, then
# hand it back to hyprmoncfg to apply. jq builds the whole document and the
# result is moved into place, so a failure anywhere leaves the profile exactly
# as it was rather than truncated.
#
# Outputs are matched by connector name, which is what the plan carries and
# what the profile records alongside its make|model|serial key. An output the
# profile does not mention is left alone: it is not part of this layout, and
# inventing an entry for it here would be guessing at every field but three.
hmc_apply() {
    name=$1
    plan=$2
    path=$(hmc_profile_path "$name")
    [ -f "$path" ] || {
        echo "qs-display-scale: no profile file at $path" >&2
        return 1
    }

    tmp=$path.qs-display-scale.$$
    if ! jq --argjson plan "$plan" '
            .outputs |= map(
                . as $out
                | (($plan[] | select(.name == $out.name)) // null) as $p
                | if $p then . + {scale: $p.scale, x: $p.x, y: $p.y} else . end
            )
         ' "$path" > "$tmp"; then
        rm -f "$tmp"
        echo "qs-display-scale: could not patch profile $name" >&2
        return 1
    fi
    mv -f "$tmp" "$path" || { rm -f "$tmp"; return 1; }

    # --confirm-timeout 0 because there is nobody at a terminal. `apply`
    # otherwise asks "Keep this configuration?" on stdin and reverts after ten
    # seconds; run from the bar it reads EOF immediately, reverts, and exits
    # non-zero - the scale lands and is gone again before the popup closes.
    # The confirmation is the right default for a person typing the command and
    # exactly wrong for a button.
    hyprmoncfg apply --confirm-timeout 0 "$name"
}

cmd_set_hypr() {
    target=$1
    factor=$2
    [ -n "$target" ] && [ -n "$factor" ] || usage
    check_factor "$factor"

    # One layout computation, whichever backend applies it. Every monitor is
    # restated with its own current mode, refresh and scale so only position
    # and the target's scale actually move. The rows are
    #
    #   M<TAB>name<TAB>w<TAB>h<TAB>refresh<TAB>x<TAB>y<TAB>scale
    #
    # with a single trailing S row carrying the pointer sensitivity.
    plan=$(query_hypr | parse_hypr | sort -t "$(printf '\t')" -k6,6n |
        awk -v target="$target" -v factor="$factor" "$HYPR_SCALE120"'
      {
          n++
          nm[n] = $1; W[n] = $3; H[n] = $4; RR[n] = $5
          OX[n] = $6; Y[n] = $7; TR[n] = $9
          f = $8
          if ($1 == target) { found = 1; ti = n; f = factor }
          # The scale we ask for is exact by construction, so Hyprland has no
          # snapping of its own to do and the re-pack below stays honest.
          K[n] = hypr_k(W[n], H[n], f)
          lw = W[n] * 120 / K[n]; lh = H[n] * 120 / K[n]
          NW[n] = (TR[n] % 2 == 1) ? lh : lw
          # The width the monitor occupies right now, snapped the same way, so
          # the anchor below is computed against the layout actually on screen.
          ok = hypr_k(W[n], H[n], $8)
          lw = W[n] * 120 / ok; lh = H[n] * 120 / ok
          CW[n] = (TR[n] % 2 == 1) ? lh : lw
      }
      END {
          if (!found) exit 3
          # Anchor the target on the edge facing the more populated side, so
          # the larger group of untouched outputs is the one that holds still
          # - see RE-PACK ANCHOR above. Then pack outward from there.
          X[ti] = (n - ti >= ti - 1) ? OX[ti] + CW[ti] - NW[ti] : OX[ti]
          for (i = ti - 1; i >= 1; i--) X[i] = X[i + 1] - NW[i]
          for (i = ti + 1; i <= n; i++) X[i] = X[i - 1] + NW[i - 1]
          for (i = 1; i <= n; i++)
              printf "M\t%s\t%d\t%d\t%s\t%d\t%d\t%.6f\n",
                     nm[i], W[i], H[i], RR[i], X[i], Y[i], K[i] / 120
          # Pointer speed compensation - see POINTER SPEED above. Derived from
          # the snapped k, not the requested factor, so it cannot disagree with
          # the scale actually in force. Only a scale of 0.5 or below hits the
          # clamp, at which point the pointer is as fast as libinput allows.
          s = 120 / K[ti] - 1
          if (s < -1) s = -1
          else if (s > 1) s = 1
          printf "S\t%.3f\n", s
      }
    ') ||
        { echo "qs-display-scale: no such enabled output: $target" >&2; exit 3; }

    [ -n "$plan" ] || { echo "qs-display-scale: no enabled outputs" >&2; exit 3; }

    sensitivity=$(printf '%s\n' "$plan" | awk -F'\t' '$1 == "S" { print $2 }')

    profile=$(hmc_profile) || profile=""

    if [ -n "$profile" ]; then
        # The same plan as a JSON array, for the profile patch.
        json=$(printf '%s\n' "$plan" | awk -F'\t' '
          BEGIN { printf "[" }
          $1 == "M" { printf "%s{\"name\":\"%s\",\"scale\":%.6f,\"x\":%d,\"y\":%d}",
                             (n++ ? "," : ""), $2, $8, $6, $7 }
          END { printf "]\n" }
        ')
        if [ "$QS_DISPLAY_SCALE_DRY" = 1 ]; then
            echo "hyprmoncfg apply $profile <- $json"
            echo "hyprctl keyword input:sensitivity $sensitivity"
            return
        fi
        if hmc_apply "$profile" "$json"; then
            hyprctl keyword input:sensitivity "$sensitivity" >/dev/null
            return
        fi
        # Fall through to the plain path rather than leave the click with
        # nothing to show for it. The daemon may revert that, which is visible
        # and recoverable; doing nothing at all is neither.
        echo "qs-display-scale: falling back to hyprctl" >&2
    fi

    # One --batch so the outputs never land in an overlapping intermediate
    # state.
    batch=$(printf '%s\n' "$plan" | awk -F'\t' -v sens="$sensitivity" '
      $1 == "M" { printf "%skeyword monitor %s,%dx%d@%s,%dx%d,%.6f",
                         (n++ ? " ; " : ""), $2, $3, $4, $5, $6, $7, $8 }
      END { printf " ; keyword input:sensitivity %s\n", sens }
    ')

    if [ "$QS_DISPLAY_SCALE_DRY" = 1 ]; then
        echo "hyprctl --batch $batch"
    else
        hyprctl --batch "$batch"
    fi
}

case $1 in
    list) if use_hypr; then cmd_list_hypr; else cmd_list; fi ;;
    set)  shift; if use_hypr; then cmd_set_hypr "$@"; else cmd_set "$@"; fi ;;
    *)    usage ;;
esac
