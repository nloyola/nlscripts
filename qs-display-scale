#!/bin/sh
# Per-monitor display scaling for the quickshell scale chip.
#
#   qs-display-scale list
#       Emit one JSON line describing every connected, enabled output:
#
#         {"outputs":[{"name":"DP-0","primary":true,"mode":"3840x2160",
#                      "logical":"1920x1080","w":1920,"h":1080,
#                      "x":0,"y":0,"factor":2.000}]}
#
#   qs-display-scale set <output> <factor>
#       Scale <output> so the desktop is magnified <factor> times, then
#       re-pack every output left to right so the new logical size does not
#       leave the outputs overlapping or gapped.
#
# `factor` is UI magnification: 2 means everything is twice as big, i.e. a 4K
# panel renders a 1920x1080 desktop. Nothing is persisted - the current factor
# is derived from the compositor itself, so the chip always reports what is
# actually on screen.
#
# TWO BACKENDS. Under Hyprland this drives `hyprctl keyword monitor`; under an
# X session it drives xrandr. The split is not cosmetic: XWayland answers
# `xrandr --query` (so `list` looked fine) but rejects RRSetScreenSize with
# BadMatch, so the xrandr-only version of this script was a silent no-op for
# every Hyprland session - the chip drew the presets and clicking one did
# nothing. XWayland also reports the outputs in its own left-to-right order,
# which need not be Hyprland's, so even the geometry it did report was wrong.
#
# HYPRLAND ROUNDING. Hyprland quantizes every scale to a multiple of 1/120
# (the wl_output scale-120 protocol) and then insists the logical size be
# integral on BOTH axes. So the accepted scales for a mode are exactly k/120
# for those k dividing both mode_w*120 and mode_h*120 - on 3840x2160, k must
# divide 28800. Hyprland will snap an invalid scale to the nearest such k
# itself, silently, which would leave the re-pack below computing positions
# from a scale that is not the one in force. So we run the same search up
# front and pass k/120 exactly, and `list` snaps the same way to recover the
# true logical size from the two decimals hyprctl prints.
#
# XRANDR ROUNDING. The framebuffer size is set with `--scale-from` rather than
# `--scale` so the rounding is ours: non-integer factors are rounded down to an
# even pixel count instead of whatever xrandr's own rounding produces.
# Untouched outputs keep their exact current framebuffer size, so repeated
# `set` calls cannot make a rounded factor drift.
#
# POINTER SPEED. Hyprland moves the cursor in logical coordinates, so the same
# hand motion crosses a scaled output in fewer logical pixels but the same
# physical distance on glass - at scale 2 the pointer visibly flies. `set`
# therefore also writes input:sensitivity, libinput's accel speed, as
# 1/scale - 1 (scale 1 -> 0, Hyprland's own default; 1.5 -> -0.333; 2 -> -0.5),
# which holds hand-distance-per-inch-of-screen roughly constant. Roughly: the
# adaptive accel profile is not linear in this value, so the correction is
# right in direction and about right in size, not literal. Sensitivity is
# global while scale is per-output, so it follows the output just scaled - the
# one being looked at. Like the scale itself nothing is persisted, and a
# `hyprctl reload` drops both back to what hyprland.conf says.
#
# Outputs are re-packed horizontally in their current left-to-right order,
# each keeping its current y. A stacked (vertical) layout is not preserved.
#
# The X output with the framebuffer at the origin is the one xrandr marks
# primary; Hyprland has no such concept, so there the origin itself is what
# "primary" reports.
#
# QS_DISPLAY_SCALE_QUERY names a file to read instead of running xrandr, and
# QS_DISPLAY_SCALE_HYPR_QUERY does the same for `hyprctl monitors`;
# QS_DISPLAY_SCALE_DRY=1 prints the command instead of running it, so both
# parsing and layout can be driven from fixtures. Setting either QUERY var
# also picks that backend, whatever session the fixture is run from.

usage() {
    echo "usage: qs-display-scale list | set <output> <factor>" >&2
    exit 2
}

# Which compositor is in charge. The fixture vars win so a test can exercise
# either backend from any session.
use_hypr() {
    [ -n "$QS_DISPLAY_SCALE_HYPR_QUERY" ] && return 0
    [ -n "$QS_DISPLAY_SCALE_QUERY" ] && return 1
    [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ] && command -v hyprctl >/dev/null 2>&1
}

query() {
    if [ -n "$QS_DISPLAY_SCALE_QUERY" ]; then
        cat "$QS_DISPLAY_SCALE_QUERY"
    else
        xrandr --query 2>/dev/null
    fi
}

query_hypr() {
    if [ -n "$QS_DISPLAY_SCALE_HYPR_QUERY" ]; then
        cat "$QS_DISPLAY_SCALE_HYPR_QUERY"
    else
        hyprctl monitors 2>/dev/null
    fi
}

# Parse `xrandr --query` into one TSV row per connected, enabled output:
#
#   name  primary  mode_w  mode_h  fb_w  fb_h  x  y
#
# The output line carries the framebuffer geometry ("3840x2160+0+0"); the
# panel's own resolution is the mode line marked with "*". Connected outputs
# that are switched off have no geometry and are skipped, as is any output
# whose current mode xrandr did not report.
parse() {
    awk '
      function emit() {
          if (name != "" && fbw > 0 && modew > 0)
              printf "%s\t%s\t%d\t%d\t%d\t%d\t%d\t%d\n",
                     name, prim, modew, modeh, fbw, fbh, x, y
          name = ""
      }
      /^[^[:space:]]/ {
          emit()
          fbw = 0; fbh = 0; x = 0; y = 0; modew = 0; modeh = 0
          if ($2 != "connected") next
          name = $1
          prim = ($3 == "primary") ? "true" : "false"
          for (i = 3; i <= NF; i++)
              if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) {
                  split($i, g, /[x+]/)
                  fbw = g[1]; fbh = g[2]; x = g[3]; y = g[4]
                  break
              }
          next
      }
      # First mode line carrying "*" is the current one.
      name != "" && modew == 0 && /\*/ {
          split($1, m, "x")
          modew = m[1]; modeh = m[2]
      }
      END { emit() }
    '
}

# Parse `hyprctl monitors` into one TSV row per enabled monitor:
#
#   name  primary  mode_w  mode_h  refresh  x  y  scale  transform
#
# The first indented line of each block is "3840x2160@59.99700 at 3840x0"; the
# rest are "key: value". A monitor at the origin is reported primary, Hyprland
# having no primary of its own.
parse_hypr() {
    awk '
      function emit() {
          if (name != "" && !disabled && modew > 0)
              printf "%s\t%s\t%d\t%d\t%s\t%d\t%d\t%.6f\t%d\n",
                     name, (x == 0 && y == 0) ? "true" : "false",
                     modew, modeh, rr, x, y, scale, tr
          name = ""
      }
      /^Monitor / {
          emit()
          name = $2; disabled = 0
          modew = 0; modeh = 0; rr = ""; x = 0; y = 0; scale = 1; tr = 0
          next
      }
      name == "" { next }
      modew == 0 && $1 ~ /^[0-9]+x[0-9]+@/ {
          split($1, a, "@"); rr = a[2]
          split(a[1], m, "x"); modew = m[1]; modeh = m[2]
          split($3, p, "x"); x = p[1]; y = p[2]
          next
      }
      $1 == "scale:"     { scale = $2; next }
      $1 == "transform:" { tr = $2; next }
      $1 == "disabled:"  { disabled = ($2 == "true"); next }
      END { emit() }
    '
}

# Shared by both hyprctl paths: the scale-120 numerator nearest f*120 that
# Hyprland will actually accept for a w x h mode. Walks outward from the ideal
# so the answer is always the closest valid scale, and falls back to 1x rather
# than looping forever on a degenerate mode.
HYPR_SCALE120='
  function hypr_k(w, h, f,   base, d, c) {
      if (f <= 0) return 120
      base = int(f * 120 + 0.5)
      if (base < 1) base = 1
      for (d = 0; d <= 120 * 120; d++) {
          c = base - d; if (c >= 1 && (w * 120) % c == 0 && (h * 120) % c == 0) return c
          c = base + d; if ((w * 120) % c == 0 && (h * 120) % c == 0) return c
      }
      return 120
  }
'

cmd_list() {
    query | parse | awk '
      BEGIN { printf "{\"outputs\":[" }
      {
          if (n++) printf ","
          printf "{\"name\":\"%s\",\"primary\":%s,\"mode\":\"%dx%d\",", $1, $2, $3, $4
          printf "\"logical\":\"%dx%d\",\"w\":%d,\"h\":%d,", $5, $6, $5, $6
          printf "\"x\":%d,\"y\":%d,\"factor\":%.3f}", $7, $8, $3 / $5
      }
      END { printf "]}\n" }
    '
}

cmd_list_hypr() {
    query_hypr | parse_hypr | awk "$HYPR_SCALE120"'
      BEGIN { printf "{\"outputs\":[" }
      {
          w = $3; h = $4; tr = $9
          k = hypr_k(w, h, $8); lw = w * 120 / k; lh = h * 120 / k
          # A rotated monitor occupies its logical size the other way round.
          ow = lw; oh = lh
          if (tr % 2 == 1) { ow = lh; oh = lw }
          if (n++) printf ","
          printf "{\"name\":\"%s\",\"primary\":%s,\"mode\":\"%dx%d\",", $1, $2, w, h
          printf "\"logical\":\"%dx%d\",\"w\":%d,\"h\":%d,", ow, oh, ow, oh
          printf "\"x\":%d,\"y\":%d,\"factor\":%.3f}", $6, $7, k / 120
      }
      END { printf "]}\n" }
    '
}

check_factor() {
    case $1 in
        *[!0-9.]* | '' | .) echo "qs-display-scale: bad factor: $1" >&2; exit 2 ;;
    esac
}

cmd_set() {
    target=$1
    factor=$2
    [ -n "$target" ] && [ -n "$factor" ] || usage
    check_factor "$factor"

    args=$(query | parse | sort -t "$(printf '\t')" -k7,7n | awk -v target="$target" -v factor="$factor" '
      function even(v) { v = int(v); if (v % 2) v--; return (v < 2) ? 2 : v }
      {
          # Untouched outputs keep their exact framebuffer, so re-packing
          # never nudges an already-rounded factor.
          w = $5; h = $6
          if ($1 == target) { found = 1; w = even($3 / factor); h = even($4 / factor) }
          printf " --output %s --scale-from %dx%d --pos %dx%d", $1, w, h, x, $8
          x += w
      }
      END { if (!found) exit 3 }
    ') || { echo "qs-display-scale: no such enabled output: $target" >&2; exit 3; }

    [ -n "$args" ] || { echo "qs-display-scale: no enabled outputs" >&2; exit 3; }

    if [ "$QS_DISPLAY_SCALE_DRY" = 1 ]; then
        echo "xrandr$args"
    else
        # shellcheck disable=SC2086  # args is a built argument list
        xrandr $args
    fi
}

cmd_set_hypr() {
    target=$1
    factor=$2
    [ -n "$target" ] && [ -n "$factor" ] || usage
    check_factor "$factor"

    # One --batch so the outputs never land in an overlapping intermediate
    # state, and every monitor is restated with its own current mode, refresh
    # and scale so only position and the target's scale actually move.
    args=$(query_hypr | parse_hypr | sort -t "$(printf '\t')" -k6,6n |
        awk -v target="$target" -v factor="$factor" "$HYPR_SCALE120"'
      {
          w = $3; h = $4; tr = $9
          f = $8
          if ($1 == target) { found = 1; f = factor }
          k = hypr_k(w, h, f); lw = w * 120 / k; lh = h * 120 / k
          if ($1 == target) tk = k
          # The scale we ask for is exact by construction, so Hyprland has no
          # snapping of its own to do and the re-pack below stays honest.
          printf " ; keyword monitor %s,%dx%d@%s,%dx%d,%.6f", $1, w, h, $5, x, $7, k / 120
          x += (tr % 2 == 1) ? lh : lw
      }
      END {
          if (!found) exit 3
          # Pointer speed compensation - see POINTER SPEED above. Derived from
          # the snapped k, not the requested factor, so it cannot disagree with
          # the scale actually in force. Only a scale of 0.5 or below hits the
          # clamp, at which point the pointer is as fast as libinput allows.
          s = 120 / tk - 1
          if (s < -1) s = -1
          else if (s > 1) s = 1
          printf " ; keyword input:sensitivity %.3f", s
      }
    ') ||
        { echo "qs-display-scale: no such enabled output: $target" >&2; exit 3; }

    [ -n "$args" ] || { echo "qs-display-scale: no enabled outputs" >&2; exit 3; }

    batch=${args# ; }
    if [ "$QS_DISPLAY_SCALE_DRY" = 1 ]; then
        echo "hyprctl --batch $batch"
    else
        hyprctl --batch "$batch"
    fi
}

case $1 in
    list) if use_hypr; then cmd_list_hypr; else cmd_list; fi ;;
    set)  shift; if use_hypr; then cmd_set_hypr "$@"; else cmd_set "$@"; fi ;;
    *)    usage ;;
esac
