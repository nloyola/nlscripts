#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-}
export LD_LIBRARY_PATH=/usr/local/lib/:${LD_LIBRARY_PATH:-}
REPO=https://github.com/emacs-mirror/emacs.git
HAVE_GCONF=0
HAVE_XAW3D=0

# Hosts that have no X server and always want a terminal-only Emacs.
NOX_HOSTS=(
    opentaproject
)

# Set EMACS_NOX=1 for a headless / terminal-only build (no X11, GTK, or image
# libraries). Native compilation and tree-sitter are still enabled. Hosts listed
# in NOX_HOSTS default to that build; EMACS_NOX still overrides either way.
default_nox() {
    local host
    host=$(hostname -s 2>/dev/null || hostname)
    local nox_host
    for nox_host in "${NOX_HOSTS[@]}"; do
        if [[ "$host" == "$nox_host" ]]; then
            echo 1
            return
        fi
    done
    echo 0
}

NOX=${EMACS_NOX:-$(default_nox)}

# Set EMACS_PGTK=1 for a pure GTK (Wayland-native) build. It cannot share a
# prefix with the X11 build - both install the same binary and share/ names - so
# it goes to its own prefix and is exposed as /usr/local/bin/emacs-pgtk. Run the
# script once per flavour to refresh both. Once built, the pgtk flavour also owns
# the plain /usr/local/bin/emacs and /usr/local/bin/emacsclient names; see
# `link_default_emacs' at the end of this script for why.
PGTK=${EMACS_PGTK:-0}

if [[ "$NOX" -eq 1 && "$PGTK" -eq 1 ]]; then
    echo "ERROR: EMACS_NOX and EMACS_PGTK are mutually exclusive." >&2
    exit 1
fi

if [[ "$PGTK" -eq 1 ]]; then
    DEST=$HOME/src/emacs/emacs-pgtk
    PREFIX=/usr/local/emacs-pgtk
    echo ">>> Building a pure GTK (Wayland-native) Emacs into $PREFIX."
else
    DEST=$HOME/src/emacs/emacs
    PREFIX=/usr/local
fi

if [[ "$NOX" -eq 1 ]]; then
    echo ">>> Building a terminal-only (-nw) Emacs: no X11, GTK, or image libraries."
fi

#CC=gcc-10
CC=gcc
CFLAGS_MINE="-O3 -mtune=native -march=native -fomit-frame-pointer"

# these settings come from here:
#   https://github.com/D4lj337/Emacs-performance
CFLAGS_MAD_SCIENTIST="-march=native -Ofast -fno-finite-math-only -pipe -fgraphite-identity -floop-nest-optimize -fdevirtualize-at-ltrans -fipa-pta -fno-semantic-interposition"

is_wsl() {
    grep -qi microsoft /proc/version 2>/dev/null
}

gcc_major_version() {
    local version
    if version=$(gcc -dumpfullversion 2>/dev/null); then
        :
    else
        version=$(gcc -dumpversion 2>/dev/null || echo 0)
    fi
    echo "${version%%.*}"
}

detect_libgccjit_package() {
    local pkg
    local major
    major=$(gcc_major_version)
    # Prefer the libgccjit package matching the currently configured GCC major version.
    local candidates=(
        "libgccjit-${major}-dev"
        libgccjit-14-dev
        libgccjit-13-dev
        libgccjit-12-dev
        libgccjit-11-dev
        libgccjit-10-dev
    )

    local seen=()
    for pkg in "${candidates[@]}"; do
        local skip=false
        local existing
        for existing in "${seen[@]}"; do
            if [[ "$pkg" == "$existing" ]]; then
                skip=true
                break
            fi
        done
        if [[ "$skip" == true ]]; then
            continue
        fi
        seen+=("$pkg")

        if apt-cache show "$pkg" >/dev/null 2>&1; then
            echo "$pkg"
            return 0
        fi
    done
    return 1
}

apt_has_package() {
    local pkg=$1
    local candidate
    candidate=$(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
    [[ -n "$candidate" && "$candidate" != "(none)" ]]
}

install_build_dependencies() {
    local packages=(
        autoconf
        automake
        build-essential
        ca-certificates
        cmake
        curl
        git
        libgnutls28-dev
        libjansson-dev
        libmailutils-dev
        libncurses-dev
        libsqlite3-dev
        libtree-sitter-dev
        libxml2-dev
        pkg-config
        texinfo
    )

    # X11, GTK, and image libraries are only needed for a GUI build.
    if [[ "$NOX" -ne 1 ]]; then
        packages+=(
            libcairo2-dev
            libgif-dev
            libglib2.0-dev
            libgtk-3-dev
            libharfbuzz-dev
            libjpeg-dev
            libmagickwand-dev
            libpng-dev
            librsvg2-dev
            libtiff-dev
            libx11-dev
            libxft-dev
            libxpm-dev
        )
    fi

    if is_wsl; then
        packages+=(
            libgtk-4-dev
            libglib2.0-dev
            libwebkit2gtk-4.1-dev
        )
    fi

    if is_wsl; then
        echo ">>> Detected Windows Subsystem for Linux. Installing the required build dependencies..."
    else
        echo ">>> Installing/refreshing build dependencies..."
    fi

    echo ">>> Updating apt package metadata..."
    sudo apt update

    local tree_sitter_runtime_pkg=""
    for candidate in libtree-sitter0 libtree-sitter0.22 libtree-sitter0.21; do
        if apt_has_package "$candidate"; then
            tree_sitter_runtime_pkg="$candidate"
            break
        fi
    done

    if [[ -n "$tree_sitter_runtime_pkg" ]]; then
        packages+=("$tree_sitter_runtime_pkg")
    else
        echo ">>> No tree-sitter runtime package found in apt; will rely on source install."
    fi

    if ! is_wsl && [[ "$NOX" -ne 1 && "$PGTK" -ne 1 ]]; then
        if apt_has_package libgconf2-dev; then
            packages+=("libgconf2-dev")
            HAVE_GCONF=1
        else
            echo ">>> libgconf2-dev not available; disabling GConf support."
        fi
        local xaw_pkg=""
        if apt_has_package xaw3dg-dev; then
            xaw_pkg="xaw3dg-dev"
        elif apt_has_package libxaw3d-dev; then
            xaw_pkg="libxaw3d-dev"
        elif apt_has_package libxaw3dxft8-dev; then
            xaw_pkg="libxaw3dxft8-dev"
        fi

        if [[ -n "$xaw_pkg" ]]; then
            packages+=("$xaw_pkg")
            HAVE_XAW3D=1
        else
            echo ">>> libxaw3d-dev not available; disabling Xaw3d support."
        fi
    fi

    local gccjit_pkg
    if gccjit_pkg=$(detect_libgccjit_package); then
        packages+=("$gccjit_pkg")
    else
        echo "ERROR: Could not find a libgccjit development package in apt." >&2
        exit 1
    fi

    # Mailutils binary is used at runtime for movemail, so install it alongside headers.
    packages+=("mailutils")

    sudo apt install -y "${packages[@]}"
}

version_ge() {
    dpkg --compare-versions "$1" ge "$2"
}

# configure silently drops optional features whose headers are missing, so a
# build can succeed and only surface the gap much later at runtime (org-roam
# needs sqlite). Fail the build instead, right after configure.
assert_configured_features() {
    local config_h="$DEST/src/config.h"
    local feature
    local missing=()

    if [[ ! -f "$config_h" ]]; then
        echo "ERROR: $config_h not found; did configure run?" >&2
        exit 1
    fi

    for feature in "$@"; do
        if ! grep -qE "^#define ${feature} 1$" "$config_h"; then
            missing+=("$feature")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "ERROR: configure did not enable required feature(s): ${missing[*]}" >&2
        echo "       Check the configure summary and install the matching -dev package" >&2
        echo "       (HAVE_SQLITE3 needs libsqlite3-dev, HAVE_TREE_SITTER needs" >&2
        echo "       libtree-sitter-dev, and so on), then re-run this script." >&2
        exit 1
    fi

    echo ">>> Verified configure enabled: $*"
}

fetch_latest_tree_sitter_version() {
    curl -fsSL "https://api.github.com/repos/tree-sitter/tree-sitter/releases/latest" \
        | python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'].lstrip('v'))"
}

install_tree_sitter_from_source() {
    local version="$1"
    local url="$2"
    local temp_dir
    temp_dir=$(mktemp -d)
    echo ">>> Building tree-sitter ${version} from source..."
    pushd "$temp_dir" >/dev/null
    curl -fsSL "$url" -o tree-sitter.tar.gz
    tar -xzf tree-sitter.tar.gz
    cd "tree-sitter-${version}"

    if [[ -f CMakeLists.txt ]]; then
        echo ">>> Building with cmake..."
        cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=Release
        cmake --build build -j"$(nproc)"
        sudo cmake --install build
    elif [[ -f Makefile ]]; then
        echo ">>> Building with make..."
        make -j"$(nproc)"
        sudo make install PREFIX=/usr/local
    else
        # tree-sitter 0.25+: lib/src/lib.c is an amalgamation that #includes all sources
        echo ">>> Compiling tree-sitter directly from lib/src/lib.c..."
        gcc -O2 -shared -fPIC -Wl,-soname,libtree-sitter.so.0 \
            -o libtree-sitter.so.0 lib/src/lib.c -Ilib/include
        sudo install -m 755 libtree-sitter.so.0 /usr/local/lib/
        sudo ln -sf libtree-sitter.so.0 /usr/local/lib/libtree-sitter.so
        sudo install -d /usr/local/include/tree_sitter
        sudo install -m 644 lib/include/tree_sitter/api.h /usr/local/include/tree_sitter/
        sudo tee /usr/local/lib/pkgconfig/tree-sitter.pc >/dev/null <<PC
prefix=/usr/local
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: tree-sitter
Description: Incremental parsing library
Version: ${version}
Libs: -L\${libdir} -ltree-sitter
Cflags: -I\${includedir}
PC
    fi

    sudo ldconfig
    popd >/dev/null
    rm -rf "$temp_dir"
}

ensure_tree_sitter_version() {
    if ! command -v pkg-config >/dev/null; then
        echo "ERROR: pkg-config is required but not installed." >&2
        exit 1
    fi

    local installed_version
    installed_version=$(pkg-config --modversion tree-sitter 2>/dev/null || true)

    local latest_version
    latest_version=$(fetch_latest_tree_sitter_version)
    local url="https://github.com/tree-sitter/tree-sitter/archive/refs/tags/v${latest_version}.tar.gz"

    if [[ -n "$installed_version" ]] && version_ge "$installed_version" "$latest_version"; then
        echo ">>> tree-sitter ${installed_version} is already up to date."
        return
    fi

    if [[ -n "$installed_version" ]]; then
        echo ">>> Updating tree-sitter ${installed_version} to latest version ${latest_version}."
    else
        echo ">>> tree-sitter not detected; installing latest version ${latest_version}."
    fi

    install_tree_sitter_from_source "$latest_version" "$url"
}

install_build_dependencies
ensure_tree_sitter_version

if is_wsl; then
    configure_args=(
        --prefix=$PREFIX
        --with-native-compilation=aot
        --with-modules
        --with-harfbuzz
        --with-compress-install
        --with-threads
        --with-included-regex
        --with-zlib
        --with-jpeg
        --with-png
        --with-imagemagick
        --with-tiff
        --with-xpm
        --with-gnutls
        --with-xft
        --with-xml2
        --with-pgtk
    )
elif [[ "$PGTK" -eq 1 ]]; then
    configure_args=(
        --prefix=$PREFIX
        --with-pgtk
        --without-gsettings
        --with-mailutils
        --with-harfbuzz
        --with-native-compilation=aot
        --with-modules
        --with-json
        --with-cairo
        --with-imagemagick
        --with-rsvg
        --with-gif
        --with-png
        --with-jpeg
        --with-tree-sitter
        --without-compress-install
    )
elif [[ "$NOX" -eq 1 ]]; then
    configure_args=(
        --prefix=$PREFIX
        --without-x
        --with-mailutils
        --with-native-compilation=aot
        --with-modules
        --with-json
        --with-tree-sitter
        --with-gnutls
        --with-zlib
        --without-compress-install
    )
else
    configure_args=(
        --prefix=$PREFIX
        --with-x-toolkit=gtk3
        --with-xft
        --without-toolkit-scroll-bars
        --without-gsettings
        --with-mailutils
        --with-harfbuzz
        --with-native-compilation=aot
        --with-modules
        --with-json
        --with-cairo
        --with-imagemagick
        --with-rsvg
        --with-gif
        --with-png
        --with-jpeg
        --with-tree-sitter
        --without-compress-install
    )

    if [[ "$HAVE_XAW3D" -eq 1 ]]; then
        configure_args+=(--with-xaw3d)
    else
        configure_args+=(--without-xaw3d)
    fi

    if [[ "$HAVE_GCONF" -eq 1 ]]; then
        configure_args+=(--with-gconf)
    else
        configure_args+=(--without-gconf)
    fi
fi

if [[ -d "${DEST}.old" ]]; then
    rm -rf "${DEST}.old"
fi

if [[ -d "${DEST}" ]]; then
    mv "$DEST" "${DEST}.old"
fi

# 1. Make sure system sees /usr/local/lib
echo ">>> Ensuring /usr/local/lib is in ldconfig paths..."
echo "/usr/local/lib" | sudo tee /etc/ld.so.conf.d/tree-sitter.conf >/dev/null
sudo ldconfig

git clone --depth 1 "$REPO" "$DEST"
cd "$DEST"
make distclean || true
./autogen.sh
./configure "${configure_args[@]}" CC=$CC CFLAGS="$CFLAGS_MAD_SCIENTIST"
required_features=(HAVE_SQLITE3 HAVE_TREE_SITTER HAVE_NATIVE_COMP HAVE_MODULES HAVE_GNUTLS)
if [[ "$PGTK" -eq 1 ]]; then
    required_features+=(HAVE_PGTK)
fi
assert_configured_features "${required_features[@]}"
make -j"$(nproc)"
sudo make install

# The pgtk build lives in its own prefix so it cannot clobber the X11 one; give
# it a stable name on PATH.
#
# It also owns the plain `emacs' and `emacsclient' names whenever it is
# installed, because the two flavours do not render alike: both take their point
# size from the same init file, but the X11 build resolves it through GTK's
# XSETTINGS/GSettings DPI (96 * text-scaling-factor) while pgtk resolves it at 96
# DPI flat, so the X11 build comes out ~20% larger for the same request. Leaving
# `emacs' pointing at whichever flavour was built last means the launcher and the
# terminal disagree about font size. Wayland is the session, so pgtk wins.
link_default_emacs() {
    local prefix=$1
    sudo ln -sfn "$prefix/bin/emacs" /usr/local/bin/emacs
    sudo ln -sfn "$prefix/bin/emacsclient" /usr/local/bin/emacsclient
    echo ">>> Default /usr/local/bin/emacs -> $prefix/bin/emacs"
}

if [[ "$PGTK" -eq 1 ]]; then
    sudo ln -sfn "$PREFIX/bin/emacs" /usr/local/bin/emacs-pgtk
    sudo ln -sfn "$PREFIX/bin/emacsclient" /usr/local/bin/emacsclient-pgtk
    echo ">>> Installed /usr/local/bin/emacs-pgtk -> $PREFIX/bin/emacs"
    link_default_emacs "$PREFIX"
elif [[ -x /usr/local/emacs-pgtk/bin/emacs ]]; then
    # `make install' of an X11 or -nox build has just overwritten
    # /usr/local/bin/emacs and /usr/local/bin/emacsclient with its own. Hand the
    # plain names back to the pgtk build; this flavour stays reachable as
    # /usr/local/bin/emacs-<version>.
    echo ">>> A pgtk build is installed; restoring it as the default emacs."
    link_default_emacs /usr/local/emacs-pgtk
fi

# Rebuild ghostel's native module. Not required by the Emacs build itself, but
# it keeps the module in step with the checkout after a toolchain refresh.
# Non-fatal: a missing ghostel checkout should not fail an otherwise good build.
if ! "${SCRIPT_DIR}/build_ghostel"; then
    echo ">>> WARNING: ghostel module build failed; run build_ghostel by hand." >&2
fi
