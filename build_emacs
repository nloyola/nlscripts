#!/bin/bash
set -euo pipefail

DEST=$HOME/src/emacs/emacs
export PKG_CONFIG_PATH=/usr/local/lib/pkgconfig:${PKG_CONFIG_PATH:-}
export LD_LIBRARY_PATH=/usr/local/lib/:${LD_LIBRARY_PATH:-}
REPO=https://github.com/emacs-mirror/emacs.git
TREE_SITTER_MIN_VERSION=0.25.10
HAVE_GCONF=0
HAVE_XAW3D=0

#CC=gcc-10
CC=gcc
CFLAGS_MINE="-O3 -mtune=native -march=native -fomit-frame-pointer"

# these settings come from here:
#   https://github.com/D4lj337/Emacs-performance
CFLAGS_MAD_SCIENTIST="-march=native -Ofast -fno-finite-math-only -pipe -fgraphite-identity -floop-nest-optimize -fdevirtualize-at-ltrans -fipa-pta -fno-semantic-interposition"

is_wsl() {
    grep -qi microsoft /proc/version 2>/dev/null
}

gcc_major_version() {
    local version
    if version=$(gcc -dumpfullversion 2>/dev/null); then
        :
    else
        version=$(gcc -dumpversion 2>/dev/null || echo 0)
    fi
    echo "${version%%.*}"
}

detect_libgccjit_package() {
    local pkg
    local major
    major=$(gcc_major_version)
    # Prefer the libgccjit package matching the currently configured GCC major version.
    local candidates=(
        "libgccjit-${major}-dev"
        libgccjit-14-dev
        libgccjit-13-dev
        libgccjit-12-dev
        libgccjit-11-dev
        libgccjit-10-dev
    )

    local seen=()
    for pkg in "${candidates[@]}"; do
        local skip=false
        local existing
        for existing in "${seen[@]}"; do
            if [[ "$pkg" == "$existing" ]]; then
                skip=true
                break
            fi
        done
        if [[ "$skip" == true ]]; then
            continue
        fi
        seen+=("$pkg")

        if apt-cache show "$pkg" >/dev/null 2>&1; then
            echo "$pkg"
            return 0
        fi
    done
    return 1
}

apt_has_package() {
    local pkg=$1
    local candidate
    candidate=$(apt-cache policy "$pkg" 2>/dev/null | awk '/Candidate:/ {print $2; exit}')
    [[ -n "$candidate" && "$candidate" != "(none)" ]]
}

install_build_dependencies() {
    local packages=(
        autoconf
        automake
        build-essential
        ca-certificates
        cmake
        curl
        git
        libgif-dev
        libgnutls28-dev
        libharfbuzz-dev
        libjansson-dev
        libjpeg-dev
        libmailutils-dev
        libmagickwand-dev
        libncurses-dev
        libpng-dev
        librsvg2-dev
        libtiff-dev
        libtree-sitter-dev
        libx11-dev
        libxft-dev
        libxml2-dev
        libxpm-dev
        pkg-config
        texinfo
    )

    if is_wsl; then
        packages+=(
            libgtk-4-dev
            libglib2.0-dev
            libwebkit2gtk-4.1-dev
        )
    fi

    if is_wsl; then
        echo ">>> Detected Windows Subsystem for Linux. Installing the required build dependencies..."
    else
        echo ">>> Installing/refreshing build dependencies..."
    fi

    echo ">>> Updating apt package metadata..."
    sudo apt update

    local tree_sitter_runtime_pkg=""
    for candidate in libtree-sitter0 libtree-sitter0.22 libtree-sitter0.21; do
        if apt_has_package "$candidate"; then
            tree_sitter_runtime_pkg="$candidate"
            break
        fi
    done

    if [[ -n "$tree_sitter_runtime_pkg" ]]; then
        packages+=("$tree_sitter_runtime_pkg")
    else
        echo ">>> No tree-sitter runtime package found in apt; will rely on source install."
    fi

    if ! is_wsl; then
        if apt_has_package libgconf2-dev; then
            packages+=("libgconf2-dev")
            HAVE_GCONF=1
        else
            echo ">>> libgconf2-dev not available; disabling GConf support."
        fi
        local xaw_pkg=""
        if apt_has_package xaw3dg-dev; then
            xaw_pkg="xaw3dg-dev"
        elif apt_has_package libxaw3d-dev; then
            xaw_pkg="libxaw3d-dev"
        elif apt_has_package libxaw3dxft8-dev; then
            xaw_pkg="libxaw3dxft8-dev"
        fi

        if [[ -n "$xaw_pkg" ]]; then
            packages+=("$xaw_pkg")
            HAVE_XAW3D=1
        else
            echo ">>> libxaw3d-dev not available; disabling Xaw3d support."
        fi
    fi

    local gccjit_pkg
    if gccjit_pkg=$(detect_libgccjit_package); then
        packages+=("$gccjit_pkg")
    else
        echo "ERROR: Could not find a libgccjit development package in apt." >&2
        exit 1
    fi

    # Mailutils binary is used at runtime for movemail, so install it alongside headers.
    packages+=("mailutils")

    sudo apt install -y "${packages[@]}"
}

version_ge() {
    dpkg --compare-versions "$1" ge "$2"
}

fetch_latest_tree_sitter_version() {
    curl -fsSL "https://api.github.com/repos/tree-sitter/tree-sitter/releases/latest" \
        | python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'].lstrip('v'))"
}

install_tree_sitter_from_source() {
    local version="$1"
    local url="$2"
    local temp_dir
    temp_dir=$(mktemp -d)
    echo ">>> Building tree-sitter ${version} from source..."
    pushd "$temp_dir" >/dev/null
    curl -fsSL "$url" -o tree-sitter.tar.gz
    tar -xzf tree-sitter.tar.gz
    cd "tree-sitter-${version}"

    if [[ -f CMakeLists.txt ]]; then
        echo ">>> Building with cmake..."
        cmake -S . -B build -DCMAKE_INSTALL_PREFIX=/usr/local -DBUILD_SHARED_LIBS=ON -DCMAKE_BUILD_TYPE=Release
        cmake --build build -j"$(nproc)"
        sudo cmake --install build
    elif [[ -f Makefile ]]; then
        echo ">>> Building with make..."
        make -j"$(nproc)"
        sudo make install PREFIX=/usr/local
    else
        # tree-sitter 0.25+: lib/src/lib.c is an amalgamation that #includes all sources
        echo ">>> Compiling tree-sitter directly from lib/src/lib.c..."
        gcc -O2 -shared -fPIC -Wl,-soname,libtree-sitter.so.0 \
            -o libtree-sitter.so.0 lib/src/lib.c -Ilib/include
        sudo install -m 755 libtree-sitter.so.0 /usr/local/lib/
        sudo ln -sf libtree-sitter.so.0 /usr/local/lib/libtree-sitter.so
        sudo install -d /usr/local/include/tree_sitter
        sudo install -m 644 lib/include/tree_sitter/api.h /usr/local/include/tree_sitter/
        sudo tee /usr/local/lib/pkgconfig/tree-sitter.pc >/dev/null <<PC
prefix=/usr/local
exec_prefix=\${prefix}
libdir=\${exec_prefix}/lib
includedir=\${prefix}/include

Name: tree-sitter
Description: Incremental parsing library
Version: ${version}
Libs: -L\${libdir} -ltree-sitter
Cflags: -I\${includedir}
PC
    fi

    sudo ldconfig
    popd >/dev/null
    rm -rf "$temp_dir"
}

ensure_tree_sitter_version() {
    if ! command -v pkg-config >/dev/null; then
        echo "ERROR: pkg-config is required but not installed." >&2
        exit 1
    fi

    local installed_version
    installed_version=$(pkg-config --modversion tree-sitter 2>/dev/null || true)
    if [[ -n "$installed_version" ]] && version_ge "$installed_version" "$TREE_SITTER_MIN_VERSION"; then
        echo ">>> tree-sitter ${installed_version} already satisfies >= ${TREE_SITTER_MIN_VERSION}."
        return
    fi

    local latest_version
    latest_version=$(fetch_latest_tree_sitter_version)
    local url="https://github.com/tree-sitter/tree-sitter/archive/refs/tags/v${latest_version}.tar.gz"

    if [[ -n "$installed_version" ]]; then
        echo ">>> tree-sitter ${installed_version} is too old; upgrading to ${latest_version}."
    else
        echo ">>> tree-sitter not detected; installing ${latest_version}."
    fi

    install_tree_sitter_from_source "$latest_version" "$url"
}

install_build_dependencies
ensure_tree_sitter_version

if is_wsl; then
    configure_args=(
        --prefix=/usr/local
        --with-native-compilation=aot
        --with-modules
        --with-harfbuzz
        --with-compress-install
        --with-threads
        --with-included-regex
        --with-zlib
        --with-jpeg
        --with-png
        --with-imagemagick
        --with-tiff
        --with-xpm
        --with-gnutls
        --with-xft
        --with-xml2
        --with-pgtk
    )
else
    configure_args=(
        --prefix=/usr/local
        --with-x-toolkit=lucid
        --with-xft
        --without-toolkit-scroll-bars
        --without-gsettings
        --with-mailutils
        --with-native-compilation=aot
        --with-modules
        --with-json
        --with-cairo
        --with-imagemagick
        --with-rsvg
        --with-gif
        --with-png
        --with-jpeg
        --with-tree-sitter
        --without-compress-install
    )

    if [[ "$HAVE_XAW3D" -eq 1 ]]; then
        configure_args+=(--with-xaw3d)
    else
        configure_args+=(--without-xaw3d)
    fi

    if [[ "$HAVE_GCONF" -eq 1 ]]; then
        configure_args+=(--with-gconf)
    else
        configure_args+=(--without-gconf)
    fi
fi

if [[ -d "${DEST}.old" ]]; then
    rm -rf "${DEST}.old"
fi

if [[ -d "${DEST}" ]]; then
    mv "$DEST" "${DEST}.old"
fi

# 1. Make sure system sees /usr/local/lib
echo ">>> Ensuring /usr/local/lib is in ldconfig paths..."
echo "/usr/local/lib" | sudo tee /etc/ld.so.conf.d/tree-sitter.conf >/dev/null
sudo ldconfig

git clone --depth 1 "$REPO" "$DEST"
cd "$DEST"
make distclean || true
./autogen.sh
./configure "${configure_args[@]}" CC=$CC CFLAGS="$CFLAGS_MAD_SCIENTIST"
make -j"$(nproc)"
sudo make install
