#!/usr/bin/env sh

# Power menu for the $mod+P binding, shared by the i3 and Hyprland sessions
# (i3/config, hypr/hyprland.conf) and by polybar's powermenu module.
#
# Each session locks and exits with its own tools, so the compositor is
# detected at runtime rather than assumed. The previous version assumed i3:
# it ran i3lock, which cannot lock a Wayland session.
#
# The labels are defined once, as variables, and the case below matches those
# same variables. They used to be written out twice - printed as "Power Off",
# "Restart" and "Logout" but matched as "Shutdown", "Reboot" and "Log Out" -
# so three of the five entries fell through to the catch-all and did nothing.
#
# Nothing here uses sudo. logind grants suspend, reboot and power-off to an
# active local session through polkit (`busctl call org.freedesktop.login1
# /org/freedesktop/login1 org.freedesktop.login1.Manager CanReboot` answers
# "yes"), and a sudo password prompt has no terminal to appear on when the
# menu is launched from a keybinding.

set -u

LOCK="  Lock"
SUSPEND="󰒲  Suspend"
LOGOUT="󰍃  Log out"
REBOOT="󰜉  Restart"
SHUTDOWN="󰐥  Power off"

# Locker and session-exit command per compositor. HYPRLAND_INSTANCE_SIGNATURE
# is set by Hyprland itself, so this holds for a session started any way; i3 is
# the remaining case, and the only other session this repo still ships. The
# lock colour is the one the $mod+Escape binding in i3/config already uses.
if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
	locker="hyprlock"
	exit_session="hyprctl dispatch exit"
else
	locker="i3lock -c 282c34"
	exit_session="i3-msg exit"
fi

lock_session() {
	# Fall back to logind rather than leaving the screen unlocked: neither
	# locker is installed on every host this script is deployed to.
	if command -v "${locker%% *}" >/dev/null 2>&1; then
		$locker
	else
		loginctl lock-session
	fi
}

# qs-dmenu draws on the quickshell command menu in the Hyprland session and
# falls back to `rofi -dmenu` everywhere else - under i3, and under Hyprland
# with the bar down. Nothing here branches on the session; the script decides,
# so this one menu still serves both.
CHOSEN=$(printf '%s\n' "$LOCK" "$SUSPEND" "$LOGOUT" "$REBOOT" "$SHUTDOWN" |
	qs-dmenu -p "Power" -- -lines 5)

# Empty means the menu was dismissed, which is not an error.
[ -n "$CHOSEN" ] || exit 0

case "$CHOSEN" in
	"$LOCK") lock_session ;;
	"$SUSPEND") systemctl suspend ;;
	"$LOGOUT") $exit_session ;;
	"$REBOOT") systemctl reboot ;;
	"$SHUTDOWN") systemctl poweroff ;;
	*) exit 1 ;;
esac
