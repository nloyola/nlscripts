#!/usr/bin/env python3
import json
import subprocess


def collect(sort_key):
    output = subprocess.check_output(
        ["ps", "-eo", "pid=,comm=,pcpu=,pmem=", f"--sort=-{sort_key}"],
        text=True,
        stderr=subprocess.DEVNULL,
    )
    rows = []
    for line in output.splitlines()[:12]:
        parts = line.split(None, 3)
        if len(parts) != 4:
            continue
        pid, name, cpu, mem = parts
        rows.append({
            "pid": int(pid),
            "name": name,
            "cpu": float(cpu),
            "mem": float(mem),
        })
    return rows

print(json.dumps({"cpu": collect("pcpu"), "mem": collect("pmem")}))
