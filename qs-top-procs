#!/usr/bin/env python3
"""Top processes by CPU and memory, as JSON, for the quickshell dashboard.

CPU is sampled as a delta rather than read from `ps -o pcpu`, which reports a
process's *lifetime average* (CPU time / elapsed time since start). Under that
metric anything short-lived that runs flat out for its whole life reports
~100%: the panel was topped by the pulsemixer the volume chip spawns every
second, and by this script's own python3. Two reads of /proc a fraction of a
second apart give the instantaneous figure top shows instead.
"""

import json
import os
import time

INTERVAL = 0.5
COUNT = 12
CLK_TCK = os.sysconf("SC_CLK_TCK")
PAGE_SIZE = os.sysconf("SC_PAGE_SIZE")
SELF = os.getpid()


def mem_total_kb():
    with open("/proc/meminfo") as fh:
        for line in fh:
            if line.startswith("MemTotal:"):
                return int(line.split()[1])
    return 0


def sample():
    """{pid: (comm, cpu_ticks, rss_pages)} for every process we can read."""
    procs = {}
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == SELF:
            continue
        try:
            with open(f"/proc/{entry}/stat") as fh:
                stat = fh.read()
            # comm is parenthesised and may itself contain spaces or ')'.
            close = stat.rindex(")")
            comm = stat[stat.index("(") + 1:close]
            fields = stat[close + 2:].split()
            # After state (index 0) the fields are offset by 3 from the
            # proc(5) numbering: utime is 14, stime 15, rss 24.
            ticks = int(fields[11]) + int(fields[12])
            rss = int(fields[21])
        except (OSError, ValueError, IndexError):
            continue
        procs[pid] = (comm, ticks, rss)
    return procs


def main():
    first = sample()
    time.sleep(INTERVAL)
    second = sample()

    total_kb = mem_total_kb()
    rows = []
    for pid, (comm, ticks, rss) in second.items():
        was = first.get(pid)
        if was is None:
            # Started during the interval - no delta to measure it with, and
            # attributing all its CPU time to the interval is exactly the
            # overstatement this script exists to avoid.
            continue
        cpu = (ticks - was[1]) / CLK_TCK / INTERVAL * 100
        mem = (rss * PAGE_SIZE / 1024) / total_kb * 100 if total_kb else 0.0
        rows.append({
            "pid": pid,
            "name": comm,
            "cpu": round(max(cpu, 0.0), 1),
            "mem": round(mem, 1),
        })

    by_cpu = sorted(rows, key=lambda r: r["cpu"], reverse=True)[:COUNT]
    by_mem = sorted(rows, key=lambda r: r["mem"], reverse=True)[:COUNT]
    print(json.dumps({"cpu": by_cpu, "mem": by_mem}))


if __name__ == "__main__":
    main()
