#!/bin/sh
# qs-media - one place that decides WHICH MPRIS player a media action means, for
# the bar's transport buttons and for the XF86Audio* keys alike.
#
# WHY THE KEYS CAME HERE. The Hyprland binds used to call
# `playerctl --player=spotify_player` directly, which is a hard pin: start a
# video in Chrome and the play key still went to Spotify, silently. Omarchy has
# no pin - its `omarchy-shell media ...` follows the active source, and
# SHIFT+Play moves between sources when there is more than one. Both of those now
# land here, on the picker this file already had.
#
# WHY source-next NEEDS STATE. playerctl is stateless: it re-picks from scratch
# on every invocation, so "the source I just switched to" cannot survive one
# keypress to the next. The choice is kept in $XDG_RUNTIME_DIR, which is the
# right lifetime - a login's worth, gone on reboot, never in $HOME.
#
# It is a preference, not a promise. A remembered player is honoured only while
# it is still on the bus; one that has quit falls straight through to the
# heuristics below, so the file can never wedge the keys on a dead source.

state_file="${XDG_RUNTIME_DIR:-/tmp}/quickshell-media-player"

players=$(playerctl -l 2>/dev/null || true)

pick_player() {
  # The source last chosen with source-next/source-prev, if it is still running.
  if [ -r "$state_file" ]; then
    remembered=$(cat "$state_file")
    for p in $players; do
      [ "$p" = "$remembered" ] && { echo "$p"; return; }
    done
  fi

  # Prefer actively playing players.
  for p in $players; do
    [ "$(playerctl -p "$p" status 2>/dev/null)" = "Playing" ] && { echo "$p"; return; }
  done

  # Prefer ncspot if present, matching your old Polybar config.
  for p in $players; do
    case "$p" in
      ncspot*) echo "$p"; return ;;
    esac
  done

  # Then any paused player.
  for p in $players; do
    [ "$(playerctl -p "$p" status 2>/dev/null)" = "Paused" ] && { echo "$p"; return; }
  done

  # Last resort: first player.
  for p in $players; do
    echo "$p"
    return
  done
}

# playerctl names carry a bus suffix - "chromium.instance1234" - which is noise
# in a notification and changes every time the app restarts.
pretty() {
  echo "$1" | sed 's/\.instance[0-9]*$//'
}

# Move the remembered source one step along the list, wrapping. $1 is 1 or -1.
cycle() {
  step=$1
  [ -n "$players" ] || {
    notify-send -t 2000 -r 3 -u low "Media" "No media players" 2>/dev/null
    return 0
  }

  count=$(echo "$players" | wc -l)
  index=$(echo "$players" | grep -Fxn "$(pick_player)" | cut -d: -f1)
  [ -n "$index" ] || index=1

  next=$(( (index - 1 + step + count) % count + 1 ))
  chosen=$(echo "$players" | sed -n "${next}p")

  printf '%s\n' "$chosen" > "$state_file"
  notify-send -t 2000 -r 3 -u low "Media source" "$(pretty "$chosen")" 2>/dev/null
}

player=$(pick_player)

case "$1" in
  status)
    if [ -n "$player" ]; then
      artist=$(playerctl -p "$player" metadata artist 2>/dev/null)
      title=$(playerctl -p "$player" metadata title 2>/dev/null)
      status=$(playerctl -p "$player" status 2>/dev/null)
      icon="󰝚"
      [ "$status" = "Playing" ] && icon="󰎆"
      if [ -n "$artist$title" ]; then
        printf '%s %s\n' "$icon" "${artist:+$artist - }$title" | cut -c1-42
      else
        printf '%s %s\n' "$icon" "$status"
      fi
    else
      echo "󰝚 no media"
    fi
    ;;
  play-pause|next|previous|stop)
    if [ -n "$player" ] && playerctl -p "$player" "$1" 2>/dev/null; then
      exit 0
    fi

    # If nothing can be controlled, launch ncspot like your i3 keybind.
    if [ "$1" = "play-pause" ]; then
      if [ -x "$HOME/.local/bin/launch_ncspot.sh" ]; then
        "$HOME/.local/bin/launch_ncspot.sh" >/dev/null 2>&1 &
      else
        notify-send "Media" "No controllable media player"
      fi
    fi
    ;;
  source-next)
    cycle 1
    ;;
  source-prev)
    cycle -1
    ;;
  current)
    # Not on any key - it is how you ask the script what the keys would act on.
    printf '%s\n' "$player"
    ;;
  *)
    echo "usage: qs-media status|play-pause|next|previous|stop|source-next|source-prev|current" >&2
    exit 2
    ;;
esac
