#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") [-c] INPUT [OUTPUT]"
    echo "Encode a video with ffmpeg using H.264/AAC."
    echo "  -c    compatibility mode: AVI container with MPEG-4 video/MP3 audio"
}

compat=0
while getopts ":ch" opt; do
    case "$opt" in
        c) compat=1 ;;
        h) usage; exit 0 ;;
        *) usage >&2; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    usage >&2
    exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "ERROR: ffmpeg is required" >&2
    exit 127
fi

infile=$1
if [ ! -f "$infile" ]; then
    echo "ERROR: input file not found: $infile" >&2
    exit 1
fi

if [ $# -eq 2 ]; then
    outfile=$2
else
    base=${infile%.*}
    if [ "$compat" -eq 1 ]; then
        outfile="${base}-encoded.avi"
    else
        outfile="${base}-encoded.mp4"
    fi
fi

if [ "$compat" -eq 1 ]; then
    ffmpeg -hide_banner -i "$infile" \
        -c:v mpeg4 -q:v 4 \
        -c:a libmp3lame -q:a 2 \
        "$outfile"
else
    ffmpeg -hide_banner -i "$infile" \
        -c:v libx264 -preset medium -crf 23 \
        -c:a aac -b:a 160k \
        -movflags +faststart \
        "$outfile"
fi
