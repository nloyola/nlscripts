#!/usr/bin/env bash
set -euo pipefail

AIRPODS_MAC="${AIRPODS_MAC:-30:82:16:8B:EC:52}"
AIRPODS_NAME="${AIRPODS_NAME:-AirPods Pro NL}"
TIMEOUT_SECONDS="${TIMEOUT_SECONDS:-20}"

log() {
  printf '%s\n' "$*"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

start_bluetooth() {
  log "Starting Bluetooth..."

  if systemctl is-active --quiet bluetooth; then
    log "Bluetooth service is already running."
  elif systemctl start bluetooth 2>/dev/null; then
    log "Bluetooth service started."
  elif have sudo; then
    sudo systemctl start bluetooth
    log "Bluetooth service started with sudo."
  else
    log "Could not start bluetooth.service. Try: sudo systemctl start bluetooth"
    return 1
  fi

  rfkill unblock bluetooth 2>/dev/null || true
  bluetoothctl power on >/dev/null
  bluetoothctl agent on >/dev/null || true
  bluetoothctl default-agent >/dev/null || true
}

known_device() {
  bluetoothctl devices | grep -qiE "^Device ${AIRPODS_MAC//:/:} |${AIRPODS_NAME}"
}

connected() {
  bluetoothctl info "$AIRPODS_MAC" 2>/dev/null | grep -q "Connected: yes"
}

# Has PipeWire built anything for these AirPods yet - either the bluez device
# (the card, which appears first) or the audio sink that follows it. Both name
# the MAC with its colons replaced by underscores.
#
# WHY NOT pactl, WHICH THIS USED TO USE. `pactl` ships in pulseaudio-utils, a
# package neither pipewire nor wireplumber pulls in, so it is present on some of
# these hosts and not others. Where it was missing this returned false forever
# and wait_for_audio below could only ever run out its timeout - silently, since
# a missing pactl looks exactly like AirPods that have not appeared yet. pw-dump
# ships with pipewire itself and is therefore always there. Same reasoning and
# the same fix as rofi-audio-output.sh next door, which was ported first.
audio_visible() {
  local underscored="${AIRPODS_MAC//:/_}"

  pw-dump 2>/dev/null | jq -e --arg mac "$underscored" '
    any(.[];
      ((.info.props."device.name" // "") | startswith("bluez_card." + $mac))
      or ((.info.props."node.name" // "") | startswith("bluez_output." + $mac))
    )
  ' >/dev/null 2>&1
}

wait_for_audio() {
  local waited=0

  while (( waited < TIMEOUT_SECONDS )); do
    if connected && audio_visible; then
      return 0
    fi
    sleep 1
    waited=$((waited + 1))
  done

  return 1
}

connect_airpods() {
  if ! known_device; then
    log "AirPods are not known to this computer. Pair them first."
    log "Expected: $AIRPODS_NAME ($AIRPODS_MAC)"
    return 2
  fi

  # Deliberately does NOT trust the AirPods. A trusted device bypasses the
  # org.bluez.Agent1 AuthorizeService call, which is what bt-consent uses to
  # ask before anything connects on its own (see nix/bt-consent.nix in
  # home_config). bt-consent reverts a trust within seconds anyway, so the old
  # `bluetoothctl trust` here was dead weight that only looked meaningful.
  # An outgoing connect like the one below needs no trust and is unaffected.

  if connected && audio_visible; then
    log "AirPods are already connected and visible to PipeWire."
    return 0
  fi

  if connected; then
    log "AirPods have a Bluetooth link but no audio profile. Reconnecting..."
    bluetoothctl disconnect "$AIRPODS_MAC" >/dev/null || true
    sleep 2
  fi

  log "Connecting to $AIRPODS_NAME ($AIRPODS_MAC)..."

  if timeout "$TIMEOUT_SECONDS" bluetoothctl connect "$AIRPODS_MAC"; then
    :
  else
    log "Initial connect attempt failed. Retrying once..."
    sleep 2
    timeout "$TIMEOUT_SECONDS" bluetoothctl connect "$AIRPODS_MAC" || true
  fi

  if wait_for_audio; then
    log "AirPods connected and visible to PipeWire."
  elif connected; then
    log "AirPods have a Bluetooth link, but PipeWire did not expose an audio device yet."
    log "They may not appear in pavucontrol until that happens."
    log "Try closing/reopening the case, disconnecting them from other devices, or running: bluetoothctl power off; sleep 3; bluetoothctl power on"
    return 1
  else
    log "AirPods not connected. Make sure the case is open and they are not connected to another device."
    return 1
  fi
}

start_bluetooth
connect_airpods
