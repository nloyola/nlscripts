#!/bin/sh
# Per-monitor backlight brightness for the quickshell display chip.
#
#   qs-display-brightness list
#       Emit one JSON line for every enabled output whose backlight can be
#       driven:
#
#         {"outputs":[{"name":"DP-0","brightness":55}]}
#
#       Outputs that answer neither way are omitted rather than reported at 0,
#       so the chip can simply leave the slider out for them.
#
#   qs-display-brightness set <output> <percent>
#       Set that monitor's backlight to <percent> (0-100).
#
# This is the real backlight, not xrandr's --brightness, which only fades the
# gamma ramp and leaves the panel as bright as it was.
#
# TWO KINDS OF BACKLIGHT. An external monitor is driven over DDC/CI, which is
# what everything below about ddcutil and bus mapping is for. A laptop panel is
# not: it has no DDC/CI brightness control at all and is driven through
# /sys/class/backlight instead. This script knew only the first kind, so on
# gudrun - a laptop, whose only display is the internal eDP-1 - `list` returned
# an empty set and the display popup drew no brightness slider whatsoever. A
# sysfs backlight is checked for first, per output, because where both exist the
# internal one is the authoritative control for that panel.
#
# Writes to a sysfs backlight go through brightnessctl rather than to the file:
# the same tool the brightness keys use (see qs-osd), so there is one story
# about permissions instead of two. Note that it needs one - the udev rule
# brightnessctl ships makes /sys/class/backlight/*/brightness group-writable by
# `video`, so the user has to BE in the video group. Without it reads still work
# and the slider appears, but every write is refused.
#
# MAPPING: ddcutil knows monitors by I2C bus and DRM connector, and how those
# line up with the compositor's output names depends on the session:
#
#   i3 / X11 (nvidia). xrandr's names do NOT match the DRM connectors - DP-0 is
#   card0-DP-1. Matching on name would quietly drive the wrong monitor, so the
#   pairing is made on the EDID's binary serial (bytes 12-15, little endian),
#   which xrandr carries in its EDID property and ddcutil prints for every
#   display. It is an exact integer match with nothing to guess at.
#
#   Hyprland / Wayland. xrandr is unusable here: it reads XWayland, which
#   publishes no EDID property at all, so the serial pairing above finds
#   nothing and every monitor drops out of `list`. Hyprland instead names each
#   output by its DRM connector, so `hyprctl monitors` gives DP-1 for
#   card0-DP-1 - an exact match against ddcutil with no EDID needed.
#
# So `scan` keys each bus under BOTH its binary serial and its bare DRM
# connector, and whichever key the session's output list yields resolves.
#
# The bus scan costs about a second, so it is cached for the session and keyed
# by the set of connected output keys: replug or swap a monitor and the key
# stops matching, so the map is rebuilt rather than pointing at a stale bus.
# Reading or writing one monitor once mapped is ~0.3s.
#
# QS_BRIGHTNESS_XRANDR, QS_BRIGHTNESS_HYPRCTL and QS_BRIGHTNESS_DETECT name
# files to read instead of running xrandr, hyprctl and ddcutil (the first two
# also force which session path is taken), QS_BRIGHTNESS_BACKLIGHTS names one
# holding "<connector>\t<device>" lines instead of walking /sys/class/backlight,
# QS_BRIGHTNESS_CACHE relocates the cache, and QS_BRIGHTNESS_DRY=1 prints the
# write instead of making it, so the parsing and mapping can be driven from
# fixtures.

VCP_BRIGHTNESS=10

CACHE=${QS_BRIGHTNESS_CACHE:-${XDG_RUNTIME_DIR:-/tmp}/qs-display-brightness.map}

usage() {
    echo "usage: qs-display-brightness list | set <output> <percent>" >&2
    exit 2
}

# "<output>\t<key>" for every connected, enabled output, where <key> is
# whatever `scan` can be asked for that output's i2c bus by. Two sources, one
# per session type; see MAPPING above.

# X11: key is the EDID's binary serial - bytes 12-15, little endian, the same
# number ddcutil reports as "Binary serial number". Outputs with no EDID are
# skipped, since there is nothing to pair them on.
xrandr_outputs() {
    if [ -n "$QS_BRIGHTNESS_XRANDR" ]; then cat "$QS_BRIGHTNESS_XRANDR"
    else xrandr --props 2>/dev/null
    fi | awk '
      function hex(c) { return index("0123456789abcdef", c) - 1 }
      function byte(s, i) { return hex(substr(s, i, 1)) * 16 + hex(substr(s, i + 1, 1)) }
      function flush() {
          if (name != "" && enabled && length(edid) >= 32)
              printf "%s\t%d\n", name,
                     byte(edid, 25) + byte(edid, 27) * 256 \
                     + byte(edid, 29) * 65536 + byte(edid, 31) * 16777216
          name = ""
      }
      /^[^[:space:]]/ {
          flush()
          enabled = 0; edid = ""; ine = 0
          if ($2 != "connected") next
          name = $1
          for (i = 3; i <= NF; i++)
              if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+$/) { enabled = 1; break }
          next
      }
      name != "" && /^[[:space:]]+EDID:/ { ine = 1; next }
      ine && /^[[:space:]]+[0-9a-f]+[[:space:]]*$/ { edid = edid $1; next }
      ine { ine = 0 }
      END { flush() }
    '
}

# Hyprland: key is the output name itself, which IS the DRM connector, so it
# matches ddcutil directly. A monitor Hyprland has turned off answers DDC/CI
# but is not something the bar shows a slider for, so `disabled: true` drops
# out here the same way an unmapped xrandr output does.
hyprctl_outputs() {
    if [ -n "$QS_BRIGHTNESS_HYPRCTL" ]; then cat "$QS_BRIGHTNESS_HYPRCTL"
    else hyprctl monitors 2>/dev/null
    fi | awk '
      /^Monitor /                      { name = $2; next }
      name != "" && $1 == "disabled:"  { if ($2 == "false") printf "%s\t%s\n", name, name
                                         name = "" }
    '
}

outputs() {
    if [ -n "$QS_BRIGHTNESS_XRANDR" ];   then xrandr_outputs
    elif [ -n "$QS_BRIGHTNESS_HYPRCTL" ]; then hyprctl_outputs
    elif [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then hyprctl_outputs
    else xrandr_outputs
    fi
}

# "<DRM connector>\t<backlight device>" for every panel under
# /sys/class/backlight. The `device` symlink points at the DRM connector the
# panel belongs to - amdgpu_bl1 -> ../../card1-eDP-1 - so stripping the card
# prefix gives exactly the name Hyprland uses for that output, and the pairing
# is an exact match with nothing to guess at.
#
# Older drivers point that symlink at the PCI device instead (intel_backlight ->
# ../../card0), which names no connector. Those are keyed "*": a machine has one
# internal panel, so a backlight that cannot say which output it belongs to can
# only belong to the internal one - and backlight_for only consults that key for
# an output whose name says it is internal.
backlights() {
    if [ -n "$QS_BRIGHTNESS_BACKLIGHTS" ]; then cat "$QS_BRIGHTNESS_BACKLIGHTS"; return; fi
    for dev in /sys/class/backlight/*; do
        [ -d "$dev" ] || continue
        node=$(readlink -f "$dev/device" 2>/dev/null) || continue
        conn=${node##*/}
        case $conn in
            card[0-9]*-*) conn=${conn#*-} ;;
            *)            conn='*' ;;
        esac
        printf '%s\t%s\n' "$conn" "${dev##*/}"
    done
}

# The backlight device driving <output>, empty if none does. eDP/LVDS/DSI are
# the connector types a built-in panel hangs off; an external monitor must never
# fall through to the "*" entry, or plugging a laptop into a screen would have
# the bar's slider for that screen silently dimming the laptop's own panel.
backlight_for() {
    backlights | awk -v want="$1" -F "\t" '
      $1 == want                                { print $2; exit }
      $1 == "*" && want ~ /^(eDP|LVDS|DSI)/     { fallback = $2 }
      END { if (fallback != "") print fallback }
    '
}

# "<key>\t<i2c bus>" for every display ddcutil can talk to, emitted once per
# key the two output sources can ask by: the bare DRM connector and the binary
# serial. A connector is never all-digits, so the two key spaces cannot collide.
scan() {
    if [ -n "$QS_BRIGHTNESS_DETECT" ]; then cat "$QS_BRIGHTNESS_DETECT"
    else ddcutil detect --verbose 2>/dev/null
    fi | awk '
      /I2C bus:/                { bus = $NF; sub(/.*i2c-/, "", bus); next }
      /DRM connector:/          { if (bus != "") {
                                      conn = $NF; sub(/^card[0-9]+-/, "", conn)
                                      printf "%s\t%s\n", conn, bus
                                  }
                                  next }
      /Binary serial number:/   { if (bus != "") { printf "%s\t%s\n", $4, bus; bus = "" } }
    '
}

# The cache is only trusted while the connected monitors are the same ones.
cached_map() {
    key=$(outputs | cut -f2 | sort | tr '\n' ',')
    [ -n "$key" ] || return 1

    if [ -r "$CACHE" ] && [ "$(head -1 "$CACHE")" = "#$key" ]; then
        tail -n +2 "$CACHE"
        return 0
    fi

    map=$(scan) || return 1
    { echo "#$key"; echo "$map"; } > "$CACHE" 2>/dev/null
    echo "$map"
}

bus_for() {
    cached_map | awk -v want="$1" '$1 == want { print $2; exit }'
}

cmd_list() {
    map=$(cached_map)
    printf '{"outputs":['
    first=1
    outputs | while IFS="$(printf '\t')" read -r name serial; do
        # A panel with its own sysfs backlight is driven there and never over
        # DDC/CI, which it does not implement anyway.
        dev=$(backlight_for "$name")
        if [ -n "$dev" ]; then
            # "amdgpu_bl1,backlight,19172,31%,62451" - field 4 is the percent
            # already rounded, which is the only field this needs.
            pct=$(brightnessctl --class=backlight --device="$dev" -m 2>/dev/null \
                  | awk -F, 'NR == 1 { gsub(/%/, "", $4); print $4 }')
            case $pct in '' | *[!0-9]*) continue ;; esac

            [ "$first" = 1 ] || printf ','
            first=0
            printf '{"name":"%s","brightness":%d}' "$name" "$pct"
            continue
        fi

        bus=$(echo "$map" | awk -v want="$serial" '$1 == want { print $2; exit }')
        [ -n "$bus" ] || continue

        # "VCP 10 C <current> <max>"; max is not always 100.
        read -r cur max <<VCP
$(ddcutil -b "$bus" getvcp "$VCP_BRIGHTNESS" --brief 2>/dev/null | awk '{ print $4, $5 }')
VCP
        [ -n "$cur" ] && [ -n "$max" ] && [ "$max" -gt 0 ] 2>/dev/null || continue

        [ "$first" = 1 ] || printf ','
        first=0
        printf '{"name":"%s","brightness":%d}' "$name" $(( (cur * 100 + max / 2) / max ))
    done
    printf ']}\n'
}

cmd_set() {
    target=$1
    percent=$2
    [ -n "$target" ] && [ -n "$percent" ] || usage
    case $percent in
        *[!0-9]* | '') echo "qs-display-brightness: bad percent: $percent" >&2; exit 2 ;;
    esac
    [ "$percent" -le 100 ] || { echo "qs-display-brightness: percent out of range: $percent" >&2; exit 2; }

    serial=$(outputs | awk -v want="$target" -F "\t" '$1 == want { print $2; exit }')
    [ -n "$serial" ] || { echo "qs-display-brightness: no such enabled output: $target" >&2; exit 3; }

    # Same order as cmd_list: sysfs backlight first, DDC/CI only for a monitor
    # that has none. brightnessctl's stderr is deliberately not discarded - the
    # one thing that goes wrong here is a permission denial from not being in
    # the video group, and swallowing it is what makes a dead slider look like
    # a broken script.
    dev=$(backlight_for "$target")
    if [ -n "$dev" ]; then
        if [ "$QS_BRIGHTNESS_DRY" = 1 ]; then
            echo "brightnessctl --class=backlight --device=$dev set $percent%"
        else
            brightnessctl --class=backlight --device="$dev" set "$percent%" >/dev/null
        fi
        return
    fi

    bus=$(bus_for "$serial")
    [ -n "$bus" ] || { echo "qs-display-brightness: $target does not answer DDC/CI" >&2; exit 3; }

    max=$(ddcutil -b "$bus" getvcp "$VCP_BRIGHTNESS" --brief 2>/dev/null | awk '{ print $5 }')
    [ -n "$max" ] && [ "$max" -gt 0 ] 2>/dev/null || max=100
    value=$(( (percent * max + 50) / 100 ))

    if [ "$QS_BRIGHTNESS_DRY" = 1 ]; then
        echo "ddcutil -b $bus setvcp $VCP_BRIGHTNESS $value"
    else
        ddcutil -b "$bus" setvcp "$VCP_BRIGHTNESS" "$value" >/dev/null 2>&1
    fi
}

case $1 in
    list) cmd_list ;;
    set)  shift; cmd_set "$@" ;;
    *)    usage ;;
esac
