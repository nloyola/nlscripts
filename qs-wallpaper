#!/bin/sh
# Per-monitor wallpaper for the quickshell display chip.
#
#   qs-wallpaper list
#       Emit one JSON line naming the wallpaper on every enabled monitor, in
#       the order X reports them:
#
#         {"mode":"fill","outputs":[{"name":"DP-0","file":"/path/a.jpg","base":"a.jpg"}]}
#
#   qs-wallpaper set <output> <file>
#       Put <file> on <output> and leave every other monitor as it was.
#
#   qs-wallpaper pick <output> [dir]
#       Open feh on [dir] (default ~/Dropbox/wallpapers, recursively) so a
#       wallpaper can be chosen for <output> by eye: n/p browse, Return sets
#       the image on show, Escape closes. Browsing starts at that monitor's
#       current wallpaper when it is still in the directory, and runs through
#       the subject folders one at a time - feh's "filename" sort is by full
#       path, where its "name" sort is by basename and interleaves them.
#
#   qs-wallpaper random [dir...]
#       Deal a different random wallpaper to every monitor from [dir...]
#       (default ~/Dropbox/wallpapers, recursively) and print the
#       "<output>\t<file>" pairs it settled on. This is what runs at login.
#
#   qs-wallpaper restore
#       Re-apply the remembered wallpapers. ~/.fehbg does the same thing and
#       is what a session normally runs; this one re-reads the monitor list
#       first, so it is the one to use after a monitor was added or moved.
#       X11 only in effect - under Hyprland the shell is already watching both
#       the state file and its own screen list, so there is nothing to redo.
#
# TWO SESSIONS, ONE STATE FILE. Who puts the image on screen depends on what
# is running the desktop:
#
#   i3 / X11. This script paints, with one `feh --bg-*` call over the root
#   window. Everything from WHY THE STATE FILE down is about that path.
#
#   Hyprland / Wayland. There is no root window to paint. feh's --bg-* does
#   not fail here - it draws on XWayland's root, which the compositor never
#   shows, so a set looked like it worked and nothing changed. The quickshell
#   bar paints instead: one background-layer surface per monitor, watching
#   this state file. So writing the file IS the apply and there is nothing to
#   run. See the wallpaper Variants in ~/.config/quickshell/default/shell.qml.
#
# The record is the same file in the same format either way, so a wallpaper
# picked in one session is still on that monitor after logging into the other.
#
# WHY THE STATE FILE: on X11, feh paints the whole root window in one go -
# there is no "just this screen" call that leaves the rest alone
# (--xinerama-index blacks the others out). So every set has to name a file for
# EVERY monitor, which means remembering what is on the ones nobody asked
# about. Wayland has no such constraint, but the shell needs the same
# per-monitor record to read. That is all the state file holds: one
# output-to-file line per monitor, in
# ${XDG_STATE_HOME:-~/.local/state}/qs-wallpaper.
#
# It is seeded from ~/.fehbg the first time an output is asked about, so the
# wallpaper already on screen survives the first set instead of being replaced
# by black.
#
# ORDERING (X11): the file list feh takes is positional - one file per
# Xinerama screen, in the server's screen order. `xrandr --listmonitors` prints
# monitors in that same order, so its output is the mapping. Nothing on the
# Wayland side is positional: every surface names its own monitor.
#
# ONE FIT MODE: feh's --bg-* flag applies to the whole call, so the fit is a
# property of the wallpaper set and not of a single monitor. It is stored on
# the state file's first line, defaults to fill, and QS_WALLPAPER_MODE
# (fill|scale|max|center|tile) changes it on the next set. `list` reports it so
# the shell can pick the matching Image fillMode.
#
# QS_WALLPAPER_MONITORS, QS_WALLPAPER_HYPRCTL and QS_WALLPAPER_FEHBG name files
# to read instead of running xrandr, running hyprctl and reading ~/.fehbg (the
# first two also force which session path is taken), QS_WALLPAPER_STATE
# relocates the state file, and QS_WALLPAPER_DRY=1 prints the feh call instead
# of making it, so the mapping and seeding can be driven from fixtures.

STATE=${QS_WALLPAPER_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/qs-wallpaper}
DEFAULT_DIR=${QS_WALLPAPER_DIR:-$HOME/Dropbox/wallpapers}
TAB=$(printf '\t')

usage() {
    echo "usage: qs-wallpaper list | set <output> <file> | pick <output> [dir]
                     | random [dir...] | restore" >&2
    exit 2
}

# Which session is running, and so which of the two paths above to take. The
# fixture variables force it, the way QS_BRIGHTNESS_* do in
# qs-display-brightness.
session() {
    if   [ -n "$QS_WALLPAPER_HYPRCTL" ];        then echo wayland
    elif [ -n "$QS_WALLPAPER_MONITORS" ];       then echo x11
    elif [ -n "$HYPRLAND_INSTANCE_SIGNATURE" ]; then echo wayland
    else echo x11
    fi
}
SESSION=$(session)

# Enabled monitors, one name per line, in the compositor's own order.

# X11: `--listmonitors` prints only the enabled ones, in Xinerama screen order,
# which is the order the positional feh call needs.
xrandr_monitors() {
    if [ -n "$QS_WALLPAPER_MONITORS" ]; then cat "$QS_WALLPAPER_MONITORS"
    else xrandr --listmonitors 2>/dev/null
    fi | awk '/^ *[0-9]+:/ { print $NF }'
}

# Hyprland: xrandr is unusable here - it reads XWayland, whose outputs need not
# track the compositor's. `hyprctl monitors` names each output by its DRM
# connector, and a monitor Hyprland has turned off is not one to deal a
# wallpaper to, so `disabled: true` drops out.
hyprctl_monitors() {
    if [ -n "$QS_WALLPAPER_HYPRCTL" ]; then cat "$QS_WALLPAPER_HYPRCTL"
    else hyprctl monitors 2>/dev/null
    fi | awk '
      /^Monitor /                      { name = $2; next }
      name != "" && $1 == "disabled:"  { if ($2 == "false") print name
                                         name = "" }
    '
}

monitors() {
    if [ "$SESSION" = wayland ]; then hyprctl_monitors; else xrandr_monitors; fi
}

# The fit mode in force: the state file's, unless the environment overrides.
mode() {
    if [ -n "$QS_WALLPAPER_MODE" ]; then echo "$QS_WALLPAPER_MODE"; return; fi
    m=$(awk '$1 == "#mode" { print $2; exit }' "$STATE" 2>/dev/null)
    echo "${m:-fill}"
}

stored_for() {
    awk -F "$TAB" -v want="$1" '$1 == want { print $2; exit }' "$STATE" 2>/dev/null
}

# The paths ~/.fehbg last put on screen, one per line, in the order feh got
# them - which is the same monitor order we use. Written by feh itself, so the
# paths are single-quoted with '\'' for any embedded quote.
fehbg_files() {
    fehbg=${QS_WALLPAPER_FEHBG:-$HOME/.fehbg}
    [ -r "$fehbg" ] || return 0
    sed -n "s/'\\\\''/\a/g; s/^[^']*'//p" "$fehbg" |
        awk -v RS="'" 'NR % 2 { gsub(/\a/, "'\''"); print }'
}

# What is on <output> now: what we remember, else what ~/.fehbg says was in
# that monitor's slot, else - for a single-file .fehbg, which is one image
# stretched over every screen - that one image.
current_for() {
    file=$(stored_for "$1")
    if [ -z "$file" ]; then
        index=$(monitors | awk -v want="$1" '$0 == want { print NR; exit }')
        [ -n "$index" ] || return 0
        seeds=$(fehbg_files)
        count=$(echo "$seeds" | grep -c .)
        [ "$count" -gt 0 ] || return 0
        [ "$count" -ge "$index" ] || index=1
        file=$(echo "$seeds" | sed -n "${index}p")
    fi
    echo "$file"
}

# Replace the state file with the "<output>\t<file>" pairs on stdin, under the
# mode in force. Written whole and moved into place, so a reader never catches
# it half-written.
write_state() {
    fit=$(mode)
    tmp=$STATE.$$

    mkdir -p "$(dirname "$STATE")" || exit 1
    { echo "#mode $fit"; cat; } > "$tmp" || exit 1
    mv -- "$tmp" "$STATE"
}

# Write the state file back with <output> set to <file>, keeping every other
# monitor's line and the mode.
remember() {
    target=$1
    file=$2

    monitors | while IFS= read -r name; do
        if [ "$name" = "$target" ]; then value=$file
        else value=$(current_for "$name")
        fi
        [ -n "$value" ] && printf '%s\t%s\n' "$name" "$value"
    done | write_state
}

# Put the remembered wallpapers on screen.
#
# On Wayland this is where the work stops: the shell owns the surfaces and is
# watching the state file, which the caller has already written. Returning
# here rather than skipping the call at each site keeps set/random/restore
# reading the same in both sessions.
#
# On X11 it is one feh call naming a file for every monitor. Monitors we know
# nothing about would leave feh a short list and shift every later screen, so
# they borrow the first known file rather than going black.
apply() {
    [ "$SESSION" = wayland ] && return 0

    fit=$(mode)
    known=""
    set --
    for name in $(monitors); do
        file=$(current_for "$name")
        [ -n "$file" ] || file=$known
        [ -n "$known" ] || known=$file
        [ -n "$file" ] || continue
        set -- "$@" "$file"
    done
    [ $# -gt 0 ] || { echo "qs-wallpaper: no wallpaper to apply" >&2; exit 3; }

    # No --no-fehbg on purpose: letting feh write ~/.fehbg keeps the ordinary
    # session restore working, and now it holds the full per-monitor list.
    if [ "$QS_WALLPAPER_DRY" = 1 ]; then
        echo "feh --bg-$fit $*"
    else
        feh "--bg-$fit" "$@"
    fi
}

cmd_list() {
    printf '{"mode":"%s","outputs":[' "$(mode)"
    first=1
    for name in $(monitors); do
        file=$(current_for "$name")
        [ "$first" = 1 ] || printf ','
        first=0
        # Only the characters JSON must not carry raw; paths are otherwise
        # passed through as they are.
        esc=$(printf '%s' "$file" | sed 's/\\/\\\\/g; s/"/\\"/g')
        printf '{"name":"%s","file":"%s","base":"%s"}' \
               "$name" "$esc" "$(basename "$esc")"
    done
    printf ']}\n'
}

cmd_set() {
    target=$1
    file=$2
    [ -n "$target" ] && [ -n "$file" ] || usage
    monitors | grep -qx -- "$target" || {
        echo "qs-wallpaper: no such enabled monitor: $target" >&2; exit 3; }
    [ -r "$file" ] || { echo "qs-wallpaper: cannot read: $file" >&2; exit 3; }

    # Refused rather than remembered. The state file is what the bar paints
    # from, into an Image, so a path it cannot decode - a video, and Omarchy
    # packages do ship those beside their stills - is a black monitor and not
    # one word anywhere about why.
    #
    # Wider than the list `random` deals from, deliberately. This is the door
    # an explicit pick comes through, so it may only refuse what genuinely
    # cannot be painted: gif and bmp are what the picker grid offers (list.sh)
    # and what the bar's Image decodes, so refusing them here would reject a
    # wallpaper that works. Dealing automatically is the narrower question -
    # an animated gif is a poor thing to land on at login - and `random` and
    # auto-wall answer it for themselves.
    case $file in
        *.jpg|*.jpeg|*.png|*.webp|*.gif|*.bmp) ;;
        *.JPG|*.JPEG|*.PNG|*.WEBP|*.GIF|*.BMP) ;;
        *) echo "qs-wallpaper: not a still image: $file" >&2; exit 3 ;;
    esac

    case $file in /*) ;; *) file=$(cd "$(dirname "$file")" && pwd)/$(basename "$file") ;; esac

    remember "$target" "$file"
    apply
}

cmd_random() {
    [ $# -gt 0 ] || set -- "$DEFAULT_DIR"
    for dir in "$@"; do
        [ -d "$dir" ] || { echo "qs-wallpaper: no such directory: $dir" >&2; exit 3; }
    done

    names=$(monitors)
    count=$(echo "$names" | grep -c .)
    [ "$count" -gt 0 ] || { echo "qs-wallpaper: no monitors" >&2; exit 3; }

    # Shuffled once and dealt out, so two monitors never draw the same image -
    # unless there are fewer wallpapers than monitors, where the deal wraps.
    pool=$(find "$@" -type f \
           \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
           2>/dev/null | shuf)
    total=$(echo "$pool" | grep -c .)
    [ "$total" -gt 0 ] || { echo "qs-wallpaper: no wallpapers under $*" >&2; exit 3; }

    pairs=$(echo "$names" | awk -v pool="$pool" -v total="$total" '
        BEGIN { n = split(pool, file, "\n") }
        { printf "%s\t%s\n", $0, file[(NR - 1) % total + 1] }
    ')

    echo "$pairs" | write_state
    apply
    echo "$pairs"
}

cmd_pick() {
    target=$1
    dir=${2:-$DEFAULT_DIR}
    [ -n "$target" ] || usage
    monitors | grep -qx -- "$target" || {
        echo "qs-wallpaper: no such enabled monitor: $target" >&2; exit 3; }
    [ -d "$dir" ] || { echo "qs-wallpaper: no such directory: $dir" >&2; exit 3; }

    # feh runs the action through /bin/sh with whatever PATH it inherited, and
    # the bar's environment need not have ~/.local/bin on it - so hand the
    # action this script by its own absolute path.
    self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

    set -- -r --sort filename --scale-down --auto-zoom --draw-actions \
           --title "wallpaper: $target" \
           --action ";[Set on $target]$self set $target %F"

    # Start where this monitor already is, when that file is still in the
    # directory being browsed - otherwise feh would refuse to start at all.
    current=$(current_for "$target")
    case $current in
        "$dir"/*) [ -r "$current" ] && set -- "$@" --start-at "$current" ;;
    esac

    if [ "$QS_WALLPAPER_DRY" = 1 ]; then
        echo "feh $* $dir"
    else
        exec feh "$@" "$dir"
    fi
}

case $1 in
    list)    cmd_list ;;
    set)     shift; cmd_set "$@" ;;
    pick)    shift; cmd_pick "$@" ;;
    random)  shift; cmd_random "$@" ;;
    restore) apply ;;
    *)       usage ;;
esac
