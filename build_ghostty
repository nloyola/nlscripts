#!/usr/bin/env bash
set -euo pipefail

DEST=$HOME/src/github/desktop/ghostty
REPO=https://github.com/ghostty-org/ghostty

install_build_dependencies() {
    echo ">>> Updating apt package metadata..."
    sudo apt update

    echo ">>> Installing build dependencies..."
    sudo apt install -y \
        git \
        curl \
        xz-utils \
        libgtk-4-dev \
        libadwaita-1-dev \
        blueprint-compiler \
        gettext \
        pkg-config \
        patchelf
}

required_zig_version() {
    # Extract minimum_zig_version from ghostty's build.zig.zon.
    local zon="${DEST}/build.zig.zon"
    if [[ ! -f "$zon" ]]; then
        echo "ERROR: ${zon} not found." >&2
        exit 1
    fi
    local version
    version=$(grep -E 'minimum_zig_version' "$zon" \
        | head -n1 \
        | sed -E 's/.*"([^"]+)".*/\1/')
    if [[ -z "$version" ]]; then
        echo "ERROR: could not parse minimum_zig_version from ${zon}." >&2
        exit 1
    fi
    echo "$version"
}

resolve_zig() {
    # Home Manager installs one wrapper per Zig minor series (zig-0.15,
    # zig-0.16, ...), so consumers that pin different versions can coexist.
    # ghostty's requireZig wants the same major.minor and at least the stated
    # patch, so the series wrapper is checked against that rule rather than
    # against an exact string.
    local version="$1"
    local series="${version%.*}"
    local binary="zig-${series}"

    if ! command -v "$binary" >/dev/null; then
        echo "ERROR: ${binary} not found on PATH." >&2
        echo "       Add pkgs.zig_${series//./_} to nix/hosts/\$(hostname -s).nix" >&2
        echo "       in home_config and run home-manager switch." >&2
        exit 1
    fi

    local found
    found=$("$binary" version)
    if [[ "${found%.*}" != "$series" ]] \
        || ! dpkg --compare-versions "$found" ge "$version"; then
        echo "ERROR: ${binary} reports ${found}, but ghostty needs ${series}.x >= ${version}." >&2
        exit 1
    fi

    command -v "$binary"
}

reclaim_caches() {
    # zig runs under sudo below, so everything it writes into the checkout is
    # root-owned until the chown at the end of a successful run. If a previous
    # run died before that point, the git fetch and clean here would fail with
    # EPERM, so take ownership up front rather than part way through.
    local stale=()
    local dir
    for dir in "${DEST}/.zig-cache" "${DEST}/zig-pkg"; do
        [[ -e "$dir" ]] || continue
        [[ "$(stat -c %U "$dir")" == "$(id -un)" ]] && continue
        stale+=("$dir")
    done
    [[ ${#stale[@]} -eq 0 ]] && return 0

    echo ">>> Reclaiming ${#stale[@]} root-owned cache dir(s) from a previous run..."
    sudo chown -R "$(id -u):$(id -g)" "${stale[@]}"
}

install_build_dependencies
reclaim_caches

# Update in place instead of rotating the checkout to <dest>.old and re-cloning.
# The rotation left a stale duplicate of the whole tree behind on every build,
# and once a tree had been built under sudo, its root-owned .zig-cache made the
# next run's `rm -rf "${DEST}.old"` fail with EPERM and abort under `set -e`.
if [[ -d "${DEST}/.git" ]]; then
    echo ">>> Updating existing checkout in ${DEST}..."
    git -C "$DEST" fetch --depth 1 origin main
    git -C "$DEST" reset --hard FETCH_HEAD
    # Clean everything, caches included. Tempting as an incremental rebuild is,
    # the cache records which libc zig resolved when it was populated, and this
    # build only produces a correct binary under sudo (see below). A cache left
    # from a run in a different environment is silently reused, zig's install
    # step then skips the byte-identical result, and the build reports success
    # while /usr/local keeps the old broken binary. Always start cold.
    git -C "$DEST" clean -xfd
else
    echo ">>> Cloning ${REPO} into ${DEST}..."
    git clone --depth 1 "$REPO" "$DEST"
fi

ZIG_VERSION=$(required_zig_version)
echo ">>> ghostty requires zig ${ZIG_VERSION}."
ZIG=$(resolve_zig "$ZIG_VERSION")
echo ">>> Using ${ZIG}"

cd "$DEST"

# The sudo is just write access to /usr/local, nothing more.
echo ">>> Building and installing to /usr/local (needs sudo)..."
sudo "$ZIG" build -p /usr/local -Doptimize=ReleaseFast

# Point the binary at the system dynamic loader.
#
# zig comes from nixpkgs, so its native target resolution picks nix's glibc and
# bakes that store path in as the interpreter:
#
#   /nix/store/<hash>-glibc-<version>/lib/ld-linux-x86-64.so.2
#
# That loader only searches nix store paths, so it never finds the system
# libxcb the gtk4 stack pulls in, and ghostty dies at startup with
# "libxcb.so.1: cannot open shared object file". Everything else about the
# binary is correct - it links the system gtk4/libadwaita fine, and running it
# through /lib64/ld-linux-x86-64.so.2 by hand works - so only PT_INTERP needs
# rewriting.
#
# Both build-time alternatives were tried on 2026-08-28 and both fail:
#
#   -Dtarget=native-linux-gnu
#       Naming the abi makes the target non-native, so zig stops adding
#       /usr/include and /usr/lib: "unable to find dynamic system library
#       'xcb' ... searched paths: none".
#
#   -Dtarget=native-linux-gnu --search-prefix /usr
#       Finds the libraries and does produce the right interpreter, but puts
#       /usr/include ahead of zig's bundled libc++ headers, so <cstring>
#       resolves <string.h> to Debian's and the vendored C++ in pkg/simdutf
#       fails to compile ("didn't find libc++'s <string.h> header", 12 errors).
#
#   --dynamic-linker
#       Rejected outright: LldCannotSpecifyDynamicLinkerForSharedLibraries,
#       because this build also produces libghostty-vt.so.
#
# Native mode is required for pkg-config to supply gtk4's header dirs, and
# native mode is exactly what bakes in the nix interpreter. Rewriting the one
# wrong ELF field afterwards is the narrowest correction available.
#
# This only surfaced when zig moved into the nix profile. The older
# nlscripts/install_zig unpacked ziglang.org tarballs into /usr/local, and that
# zig resolved the system loader on its own.
SYSTEM_LOADER=/lib64/ld-linux-x86-64.so.2
if [[ ! -e "$SYSTEM_LOADER" ]]; then
    echo "ERROR: ${SYSTEM_LOADER} not found; cannot fix the interpreter." >&2
    exit 1
fi

echo ">>> Pointing the interpreter at ${SYSTEM_LOADER}..."
sudo patchelf --set-interpreter "$SYSTEM_LOADER" /usr/local/bin/ghostty

# Everything zig wrote as root now belongs to the invoking user again, so the
# next run can update the checkout and clean the tree without sudo.
echo ">>> Restoring cache ownership to $(id -un)..."
sudo chown -R "$(id -u):$(id -g)" "$DEST/.zig-cache" "$DEST/zig-pkg" 2>/dev/null || true

# Smoke test. A build can succeed and still install something that will not
# start - a wrong interpreter does exactly that, and nothing else here would
# notice.
if ! /usr/local/bin/ghostty --version >/dev/null 2>&1; then
    echo "ERROR: the installed ghostty does not start:" >&2
    /usr/local/bin/ghostty --version 2>&1 | sed 's/^/       /' >&2
    exit 1
fi

echo ">>> Installed $(/usr/local/bin/ghostty --version | head -n1)"
