#!/usr/bin/env bash
set -euo pipefail

# Build quickshell from source with BOTH X11/i3 and Wayland/Hyprland support,
# and install it to /usr/local.
#
# WHY: the binary this replaces was configured with -DWAYLAND=OFF and reported
# itself as "Local Debian Trixie i3 build", with every Hyprland feature listed
# as "OFF (Requires WAYLAND)". That was fine while quickshell only ever ran
# under i3 - the sway session used waybar instead - but the Hyprland session
# needs the bar, and the bar needs the Wayland and Hyprland modules compiled in.
#
# The X11 and I3 features stay ON deliberately. One binary then serves both the
# i3/X11 session and the Hyprland session, so ~/.config/quickshell/default can
# import both Quickshell.I3 and Quickshell.Hyprland and choose at runtime. Build
# it with Wayland only and the i3 bar dies the moment this installs.
#
# NOTE: quickshell links private Qt APIs and MUST be rebuilt after every Qt
# update, or it will crash on an ABI mismatch. If the bar starts crashing after
# an apt upgrade that touched qt6, re-run this script first.
#
# That obligation is now per-host: this runs on asterix (Debian trixie, Qt 6.8)
# and on gudrun (Ubuntu 26.04, Qt 6.10), whose Qt moves on a different cadence,
# so the two will need rebuilds at different times. The build itself branches on
# the distribution in exactly two places - the dependency list and the crash
# handler - and is otherwise identical on purpose.

# Which distribution this is running on. The dependency set and one build flag
# differ between asterix (Debian trixie) and gudrun (Ubuntu 26.04); everything
# else about the build is deliberately identical, so that one script serves both
# and the two hosts cannot drift into different quickshell feature sets.
distro_id() {
    # shellcheck disable=SC1091
    . /etc/os-release 2>/dev/null && echo "${ID:-unknown}"
}

DEST=$HOME/src/quickshell
REPO=https://git.outfoxxed.me/quickshell/quickshell
BUILD_DIR="${DEST}/build"
PREFIX=/usr/local

install_build_dependencies() {
    echo ">>> Updating apt package metadata..."
    sudo apt update

    # Common to both hosts. Everything here exists under the same name in
    # Debian trixie and Ubuntu 26.04.
    #
    # The pipewire, pam, glib/polkit and xcb entries are new here. They back
    # features quickshell enables by DEFAULT - SERVICE_PIPEWIRE, SERVICE_PAM,
    # SERVICE_POLKIT and X11 - so a missing one is a configure failure, not a
    # smaller binary. They went unlisted for as long as this script had one
    # host, because asterix already had them installed for other reasons, which
    # is exactly the sort of thing a second host discovers.
    echo ">>> Installing build dependencies..."
    sudo apt install -y \
        cmake \
        ninja-build \
        pkg-config \
        qt6-base-dev \
        qt6-declarative-dev \
        qt6-declarative-private-dev \
        qt6-shadertools-dev \
        qt6-wayland \
        qt6-wayland-dev \
        qt6-wayland-private-dev \
        libdrm-dev \
        libwayland-dev \
        libjemalloc-dev \
        libcli11-dev \
        libpipewire-0.3-dev \
        libpam0g-dev \
        libglib2.0-dev \
        libpolkit-agent-1-dev \
        libpolkit-gobject-1-dev \
        libxcb1-dev \
        spirv-tools

    # Two dependencies that differ by distribution, both only needed because
    # this is a WAYLAND=ON build (the old X11-only build compiled no protocol
    # files and had no crash handler dependency to satisfy).
    #
    #   wayland-protocols  quickshell master references the ext-background-effect
    #                      staging protocol, which first ships in 1.45.
    #   libcpptrace-dev    backs the crash handler, which upstream asks
    #                      packagers to leave enabled.
    if [[ "$(distro_id)" == ubuntu ]]; then
        # Ubuntu 26.04 carries wayland-protocols 1.47 in the ordinary archive,
        # so it joins the call above rather than needing a target release.
        #
        # It has NO libcpptrace-dev at any version, so the crash handler cannot
        # be built here and is turned off in configure() instead. That is a
        # smaller loss than it sounds: it costs a symbolised backtrace on a
        # crash, not any runtime behaviour.
        echo ">>> Ubuntu: wayland-protocols from the archive; no cpptrace available..."
        sudo apt install -y wayland-protocols
    else
        # Trixie proper has neither at a usable version: no libcpptrace-dev at
        # all, and wayland-protocols 1.44. Backports has 1.0.4 and 1.47, and is
        # already enabled on asterix because Hyprland itself comes from it (see
        # ansible/host_vars/asterix.yml). Being NotAutomatic it needs an
        # explicit target release rather than joining the call above.
        echo ">>> Debian: cpptrace and newer wayland-protocols from backports..."
        sudo apt install -y -t trixie-backports libcpptrace-dev wayland-protocols
    fi
}

# Deliberately does NOT pull by default, unlike the other build_* scripts.
# quickshell links private Qt APIs and the shell in this repo
# (user/.config/quickshell/default) is written against the QML API of whatever
# revision is checked out, so bumping the revision is a separate decision from
# changing build flags - and a bad one to make silently while chasing a build
# problem. Pass QS_PULL=1 when you actually mean to update.
fetch_source() {
    if [[ ! -d "${DEST}/.git" ]]; then
        echo ">>> Cloning quickshell into ${DEST}..."
        git clone "$REPO" "$DEST"
    elif [[ "${QS_PULL:-0}" == "1" ]]; then
        echo ">>> QS_PULL=1: updating ${DEST}..."
        git -C "$DEST" pull --ff-only
    else
        echo ">>> Using the checked-out revision ($(git -C "$DEST" rev-parse --short HEAD));"
        echo "    set QS_PULL=1 to update first."
    fi
}

configure() {
    # A stale cache from the old -DWAYLAND=OFF configure would otherwise win:
    # CMake keeps cached option values, so flipping WAYLAND on requires either
    # a fresh cache or an explicit override. Removing it is the honest option.
    if [[ -f "${BUILD_DIR}/CMakeCache.txt" ]] \
        && grep -q '^WAYLAND:BOOL=OFF' "${BUILD_DIR}/CMakeCache.txt"; then
        echo ">>> Discarding the old X11-only CMake cache..."
        rm -rf "$BUILD_DIR"
    fi

    # The X11 and I3 features stay ON on BOTH hosts, even though gudrun has no
    # i3 session to use them. Keeping the flags identical is what keeps this one
    # script honest: the two hosts then run the same build with the same feature
    # set, and a bar that works on one cannot fail on the other for a reason
    # nobody wrote down. A smaller binary is not worth that.
    local crash=ON distributor="Local Debian Trixie i3+Hyprland build"
    if [[ "$(distro_id)" == ubuntu ]]; then
        # No libcpptrace-dev in the Ubuntu archive; see install_build_dependencies.
        crash=OFF
        distributor="Local Ubuntu i3+Hyprland build"
    fi

    echo ">>> Configuring (crash handler: $crash)..."
    cmake -GNinja -B "$BUILD_DIR" -S "$DEST" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX="$PREFIX" \
        -DDISTRIBUTOR="$distributor" \
        -DCRASH_HANDLER="$crash" \
        -DWAYLAND=ON \
        -DHYPRLAND=ON \
        -DX11=ON \
        -DI3=ON
}

build_and_install() {
    echo ">>> Building..."
    cmake --build "$BUILD_DIR"

    echo ">>> Installing to ${PREFIX} (needs sudo)..."
    sudo cmake --install "$BUILD_DIR"
}

verify() {
    echo ">>> Installed version and feature set:"
    "${PREFIX}/bin/quickshell" --version

    if "${PREFIX}/bin/quickshell" --version | grep -q 'Hyprland: OFF'; then
        echo "ERROR: Hyprland support is still off. Check the configure output" >&2
        echo "       above for a missing Wayland dependency." >&2
        exit 1
    fi
}

install_build_dependencies
fetch_source
configure
build_and_install
verify

echo
echo ">>> Done. Restart the bar to pick up the new binary:"
echo "      pkill -x quickshell; quickshell &"
