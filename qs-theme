#!/bin/sh
# One palette, six apps. The desktop's theme resolver and renderer.
#
#   qs-theme set <name>
#       Resolve <name>, render every template in ~/.config/theme/templates
#       into ~/.local/state/theme, deal that theme's wallpapers to the
#       monitors, tell the running apps to re-read, and record the name. This
#       is the single entry point: the bar chip, the theme IpcHandler, a
#       keybind and a TTY all come through here.
#
#   qs-theme list        Theme names, one per line, in cycle order.
#   qs-theme wallpapers [name]
#                        The wallpapers a theme owns, expanded, one path per
#                        line.
#   qs-theme previews    Every theme's name, preview image and colours, as
#                        JSON, for the picker grid (qs-theme-picker).
#   qs-theme current     The theme in force.
#   qs-theme cycle       Set the next one after it, wrapping.
#   qs-theme color <key> [fallback]
#       One resolved value for the current theme - authored or derived. This
#       is the hook for anything that wants a colour without a template.
#   qs-theme refresh [--write] [name...]
#       Re-fetch every theme that names an upstream and print what has moved
#       there since it was taken. --write applies it. See UPSTREAM below.
#   qs-theme install <repo-url> [name]
#       Add an Omarchy theme package as a theme here: its colors.toml, the
#       URL to track it by, and its backgrounds copied into the wallpaper
#       library. Refuses a package that does not resolve.
#   qs-theme remove <name>
#       Drop a theme. Leaves its wallpapers where they are.
#   qs-theme inventory
#       kind<TAB>name<TAB>repository, one theme per line. kind is "user" for
#       one installed from a package and "stock" for one authored here, which
#       is the difference between a theme that can be removed and put back and
#       one that cannot. For the theme manager.
#   qs-theme preview-links [--force] [--offline] [dir]
#       Fill dir with <name>.png symlinks to each theme's preview - the
#       desktop screenshot its upstream publishes, or a palette card drawn
#       here when it publishes none - and print dir. Fetches and draws
#       whatever is missing first. --force refetches every screenshot and
#       redraws every card; --offline skips the network, so a theme with no
#       cached screenshot falls back to its card. The picker grid is a
#       directory of images, so this is what makes the themes look like one.
#
# WHY A DIRECTORY OF THEMES AND NOT A WALLPAPER. Picking a wallpaper does not
# retheme anything, here or in Omarchy, whose model this follows: a theme is
# the primary object and its wallpapers are a property of it, chosen to suit
# it. Nothing derives a palette from an image. That was tried here once and
# backed out - see ~/.config/rofi/config.pre-pywal.rasi.
#
# WHY THE STATE DIRECTORY IS NOT UNDER ~/.config. Home Manager symlinks
# ~/.config/theme live into the home_config working tree (nix/hosts/asterix.nix),
# so anything generated under it would dirty the repo on every theme switch.
# The generated files are therefore in ${XDG_STATE_HOME:-~/.local/state}/theme,
# and each consumer is pointed at them by an include directive it already had:
#
#   palette.json          quickshell bar   FileView               live
#   theme.name            bar, scripts     FileView               live
#   alacritty-colors.toml alacritty        import =               automatic
#   ghostty-colors.conf   ghostty          config-file =          SIGUSR2
#   rofi-colors.rasi      rofi             @import                next launch
#   hypr-colors.conf      Hyprland         source = + $vars       hyprctl reload
#   mako-config           mako             mako -c <path>         makoctl reload
#
# Two consumers have no include directive, so their whole config is generated:
# mako (which is why its template carries settings that are not colours) and
# btm, whose ~/.config/bottom/bottom.toml is written in place.
#
# THE CASCADE. A theme authors ~17 keys and gets ~40, so a template can ask for
# bright_red or color9 without every theme having to spell them out. In order:
# the file, then mode, then the Omarchy remap below if the file is one of
# theirs, then semantic defaults (orange <- yellow, inactive <- dim,
# critical <- red, cursor <- bright_foreground, selection <- lighter_background,
# selection_text <- whichever of the foreground and the background contrasts
# with the selection more), then derived shades by linear mix, then ANSI
# aliasing. `qs-theme color <key>` is the way to see what any of it resolved
# to.
#
# OMARCHY THEMES. An upstream colors.toml drops into themes/<name>/ verbatim
# and resolves as itself - see the two remaps in the awk below for what each
# renames and what it derives. Packages come in two shapes: one that names
# roles (light_foreground, dark_foreground) and one that is a bare
# color0..color15 table, and the key that exists only in each is what tells
# them apart. Every theme here with an Omarchy package is that package's own
# file, unedited.
#
# UPSTREAM. Such a theme also carries themes/<name>/upstream: one line, the
# URL of the colors.toml it was taken from. That is what makes `refresh` a
# command rather than a chore - the file is the whole record of where the
# theme came from, so nothing has to remember which tree or which branch.
#
# A theme that wants to differ from its upstream appends its overriding keys
# to colors.toml under this line, on its own:
#
#   # qs-theme: local overrides below this line
#
# refresh replaces everything above that line and keeps everything below it,
# so a deviation survives an update instead of being silently reverted. The
# overrides must be written in upstream vocabulary - light_foreground rather
# than muted - because the two formats disagree about what muted names.
#
# QS_THEME_DIR relocates the theme directory, QS_THEME_STATE the generated one,
# QS_THEME_CACHE the preview cache, QS_THEME_BOTTOM the btm config, and
# QS_THEME_DRY=1 renders without touching wallpapers or signalling anything -
# which is what the test script drives.

THEME_DIR=${QS_THEME_DIR:-$HOME/.config/theme}
STATE=${QS_THEME_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/theme}
BOTTOM_CONFIG=${QS_THEME_BOTTOM:-$HOME/.config/bottom/bottom.toml}
WALLPAPER=${QS_THEME_WALLPAPER:-$HOME/.local/bin/qs-wallpaper}
# Where install puts a package's backgrounds. Outside the repo, like every
# other wallpaper set: the palette is version controlled and the images are
# not.
WALLPAPER_LIB=${QS_THEME_WALLPAPER_LIB:-$HOME/Dropbox/wallpapers}
# Everything the picker grid is drawn from: fetched screenshots, generated
# cards and the link farm over them. All of it is derivable from the themes
# and can be thrown away at any time, which is what makes it a cache.
CACHE_DIR=${QS_THEME_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/qs-theme}
PREVIEW_IMAGE_DIR=$CACHE_DIR/preview-images
PREVIEW_CARD_DIR=$CACHE_DIR/preview-cards
DEFAULT_THEME=doomone
TAB=$(printf '\t')

# The line in a colors.toml below which everything belongs to this repo. Kept
# as one exact string because refresh both matches on it and writes it.
OVERRIDE_MARK='# qs-theme: local overrides below this line'

usage() {
    echo "usage: qs-theme set <name> | cycle | list | current | previews
                    | wallpapers [name] | color <key> [fallback]
                    | refresh [--write] [name...]
                    | install <repo-url> [name] | remove <name>
                    | check <repo-url> [name]
                    | inventory
                    | preview-links [--force] [--offline] [dir]" >&2
    exit 2
}

die() { echo "qs-theme: $*" >&2; exit 1; }

# The two verdicts check returns besides "installable". They are not die
# because the exit status is the whole point of the command: 4 is a fact
# about the package and 5 is an admission that nothing was learned about it,
# and a caller has to show a different thing for each.
unusable()    { echo "qs-theme: $*" >&2; exit 4; }
uncheckable() { echo "qs-theme: $1: could not be checked - $2" >&2; exit 5; }

# ── Resolve ──────────────────────────────────────────────────────────────
# Emit the whole resolved palette for one theme as "key<TAB>value" lines.
#
# Values become sed replacement text a moment later, so both sides are charset
# checked here: a key that is not [A-Za-z0-9_-]+ or a value carrying the sed
# delimiter, a backslash or an & is dropped with a warning. Dropping it is what
# leaves a raw {{ }} in the output, which the render step then refuses - far
# better than quietly writing a broken colour into a live config.
resolve() {
    name=$1
    file=$THEME_DIR/themes/$name/colors.toml
    [ -r "$file" ] || die "no such theme: $name"

    awk -v theme="$name" '
      BEGIN { HEX = "0123456789abcdef" }

      # ── hex arithmetic ──────────────────────────────────────────────
      function hv(c,   i) { i = index(HEX, tolower(c)); return i - 1 }
      function comp(h, i,   s) {
          s = substr(h, 2 + 2 * i, 2)
          return hv(substr(s, 1, 1)) * 16 + hv(substr(s, 2, 1))
      }
      function byte(n) {
          if (n < 0) n = 0; if (n > 255) n = 255
          return sprintf("%02x", int(n + 0.5))
      }
      # A linear interpolation between two #rrggbb, p of the way from a to b.
      # Every derived shade in the cascade is one of these.
      function mix(a, b, p) {
          return "#" byte(comp(a,0) + (comp(b,0) - comp(a,0)) * p) \
                     byte(comp(a,1) + (comp(b,1) - comp(a,1)) * p) \
                     byte(comp(a,2) + (comp(b,2) - comp(a,2)) * p)
      }

      # WCAG relative luminance, and the contrast ratio between two colours.
      # Used for one decision only - which end of the palette selected text
      # is drawn in - but it is the one place a wrong guess makes a config
      # illegible rather than merely ugly, so it is measured, not eyeballed.
      function srgb(c,   x) {
          x = c / 255
          return (x <= 0.03928) ? x / 12.92 : ((x + 0.055) / 1.055) ^ 2.4
      }
      # Named in full because `lum` is already a variable in the mode
      # heuristic below, which is a cruder sum and stays that way.
      function luminance(h) {
          return 0.2126 * srgb(comp(h,0)) + 0.7152 * srgb(comp(h,1)) \
               + 0.0722 * srgb(comp(h,2))
      }
      function contrast(a, b,   la, lb) {
          la = luminance(a); lb = luminance(b)
          return (la > lb) ? (la + 0.05) / (lb + 0.05) : (lb + 0.05) / (la + 0.05)
      }

      function have(k) { return (k in A) && A[k] != "" }
      function def(k, v) { if (!have(k)) A[k] = v }

      # ── The Omarchy colors.toml ───────────────────────────────────────
      # Upstream themes are flat colors.toml files of the same shape as
      # these, and most of the themes here began as one transcribed by hand.
      # The transcription was mechanical, so it happens here instead and an
      # upstream theme drops into themes/ verbatim, updated by a git pull
      # rather than a re-port.
      #
      # The four renames are not cosmetic. `muted` names opposite ends of
      # the palette in the two formats - here the light one, upstream the
      # dark one - so a file read without this would put the upstream dark
      # value everywhere this palette expects its light one, in every
      # template, silently. light_foreground and dark_foreground exist only
      # upstream, which is what makes them the discriminator.
      function omarchy(   hue, i, n, out, seen) {
          def("dim", A["muted"])                    # before muted is retaken
          if (have("light_foreground")) A["muted"] = A["light_foreground"]
          def("inactive", A["dark_foreground"])
          chrome()
      }

      # ── the color0..color15 packages ─────────────────────────────────
      # The other shape a community Omarchy theme comes in: accent, cursor,
      # foreground, background, both ends of the selection, and a bare ANSI
      # table. It assigns no roles, so where the file above says what a
      # colour is for, this one says only where it sits in a terminal, and
      # the roles are read off those slots.
      #
      # muted and dim are the two that are a reading rather than a rename.
      # color7 is the normal white, the ordinary text a shade below the
      # foreground; color8 is the bright black, which every one of these
      # packages uses for the faint work - borders, inactive text, the
      # dimmest line in walker and mako. Those are the roles muted and dim
      # fill here, so that is where those two slots go.
      #
      # What no such package states is the bar chrome proper -
      # lighter_background, accents, and any accent2 that is not the
      # magenta. A theme that wants those keeps them below the override
      # marker; the fallbacks here are so a package can still be dropped in
      # whole and resolve.
      function omarchy_ansi(   hue, i, n) {
          def("black", A["color0"])
          n = split("red green yellow blue magenta cyan", hue, " ")
          for (i = 1; i <= n; i++) def(hue[i], A["color" i])
          def("white", A["color7"])
          def("muted", A["color7"])
          def("dim",   A["color8"])

          # The bright row is authored here, not a lightening of the normal
          # one - several of these rotate the hue instead - so it is taken
          # slot for slot rather than derived.
          n = split("black red green yellow blue magenta cyan white", hue, " ")
          for (i = 1; i <= n; i++) def("bright_" hue[i], A["color" (i + 7)])

          def("selection",      A["selection_background"])
          def("selection_text", A["selection_foreground"])

          # The one key with nothing behind it at all. These packages theme
          # every panel as the background with a border, so there is no
          # surface colour to take; a fifth of the way to the accent is the
          # step the dark themes here already use.
          def("lighter_background", mix(A["background"], A["accent"], 0.20))
          chrome()
      }

      # What both remaps derive once the hues are in place, because neither
      # upstream format carries any of it.
      function chrome(   hue, i, n, out, seen) {
          def("accent2",  A["magenta"])
          def("rainbow",  "false")                  # no upstream asks for it
          def("orange",   A["yellow"])              # needed by accents below

          # popup_border has no upstream analogue at all: the accent lifted
          # toward white, or dropped toward black on a light theme, where a
          # lifted one would outline the popup in something paler than its
          # own background.
          if (!have("popup_border"))
              A["popup_border"] = (A["mode"] == "light") \
                  ? mix(A["accent"], "#000000", 0.25) \
                  : mix(A["accent"], "#ffffff", 0.40)

          # The accent cycle, in the order every hand-port chose. Deduped:
          # a palette whose accent is also its magenta would otherwise give
          # the bar the same colour twice in a row.
          if (!have("accents")) {
              n = split("accent magenta green orange cyan", hue, " ")
              out = ""
              for (i = 1; i <= n; i++) {
                  if (!have(hue[i]) || (A[hue[i]] in seen)) continue
                  seen[A[hue[i]]] = 1
                  out = out (out == "" ? "" : " ") A[hue[i]]
              }
              A["accents"] = out
          }
      }

      # ── the file ────────────────────────────────────────────────────
      # Flat `key = "value"`, line based. Deliberately not a TOML parser:
      # there are no tables, arrays or multi-line strings in a colors.toml,
      # and a real parser would be a dependency for nothing.
      /^[ \t]*#/ { next }
      /^[ \t]*[A-Za-z0-9_-]+[ \t]*=/ {
          key = $0; sub(/[ \t]*=.*/, "", key); sub(/^[ \t]+/, "", key)
          val = $0; sub(/^[^=]*=[ \t]*/, "", val)
          if (val ~ /^"/) { sub(/^"/, "", val); sub(/".*$/, "", val) }
          else            { sub(/[ \t]*#.*$/, "", val); sub(/[ \t]+$/, "", val) }

          # Upstream ships hex in whatever case its author wrote, and a theme
          # read verbatim would carry that into every generated config, mixed
          # in among the lowercase every other theme produces. Folded here, at
          # the only door values come in by, so nothing downstream has to
          # care. Derived values are already lowercase - they come out of
          # sprintf("%02x"). Guarded so mode and rainbow are left alone.
          if (val ~ /^#[0-9A-Fa-f]+([ \t]+#[0-9A-Fa-f]+)*$/) val = tolower(val)

          if (val ~ /[|\\&]/ || val ~ /{{/) {
              printf "qs-theme: %s: bad character in value for %s, ignored\n",
                     theme, key > "/dev/stderr"
              next
          }
          A[key] = val
          next
      }

      END {
          A["name"] = theme

          # ── mode ─────────────────────────────────────────────────────
          # An explicit key wins; otherwise the background decides. Resolved
          # first because the Omarchy remap below derives popup_border in
          # opposite directions on a light and a dark theme.
          if (!have("mode")) {
              lum = comp(A["background"],0) + comp(A["background"],1) + comp(A["background"],2)
              A["mode"] = (lum > 382) ? "light" : "dark"
          }

          # Which upstream this is, if it is one. light_foreground and
          # dark_foreground exist only in the first format and color0 only
          # in the second, so neither discriminator can reach a theme
          # authored here.
          if (have("light_foreground") || have("dark_foreground")) omarchy()
          else if (have("color0")) omarchy_ansi()

          # Authored keys with no sensible derivation. A theme missing one of
          # these would render a config full of empty colours, so say so.
          split("background foreground lighter_background muted dim accent " \
                "accent2 popup_border accents rainbow red green yellow blue " \
                "magenta cyan", req, " ")
          missing = ""
          for (i in req) if (!have(req[i])) missing = missing " " req[i]
          if (missing != "") {
              printf "qs-theme: %s: colors.toml is missing:%s\n",
                     theme, missing > "/dev/stderr"
              exit 1
          }

          # ── semantic defaults ────────────────────────────────────────
          # Ordered: each may feed the next.
          def("orange",   A["yellow"])       # rose palettes have no orange
          def("black",    A["background"])   # ANSI 0 and 7 are the terminal
          def("white",    A["foreground"])   # ends of the same two colours
          def("inactive", A["dim"])
          def("critical", A["red"])

          # ── derived shades ───────────────────────────────────────────
          # def() rather than assignment: an Omarchy theme authors its own
          # brights and background shades, and they are not always the linear
          # mix derived here. Where a theme said, its value stands - that is
          # the part its author tuned by eye.
          def("dark_background",   mix(A["background"], "#000000", 0.25))
          def("darker_background", mix(A["background"], "#000000", 0.50))
          split("black red green yellow blue magenta cyan orange foreground white",
                hue, " ")
          for (i in hue) def("bright_" hue[i], mix(A[hue[i]], "#ffffff", 0.20))

          def("cursor",    A["bright_foreground"])
          def("selection", A["lighter_background"])

          # The text drawn on a selection: whichever end of the palette
          # stands further from the selection itself. A theme is free to
          # author a selection that sits up near its foreground - the newer
          # Omarchy colors.toml carries a selection_foreground precisely
          # because several upstreams do - and a template that hardcoded the
          # foreground here would render invisible text. Measured, so no
          # theme has to remember.
          if (contrast(A["selection"], A["foreground"]) >= contrast(A["selection"], A["background"]))
              def("selection_text", A["foreground"])
          else
              def("selection_text", A["background"])

          # ── ANSI aliasing ────────────────────────────────────────────
          # So the terminal templates can name color0..color15 unconditionally.
          split("black red green yellow blue magenta cyan white", ansi, " ")
          for (i = 1; i <= 8; i++) {
              A["color" (i - 1)] = A[ansi[i]]
              A["color" (i + 7)] = A["bright_" ansi[i]]
          }

          # ── the two byte orders of one translucent background ────────
          # Qt writes #AARRGGBB, mako wants #RRGGBBAA. Both come from here, so
          # no consumer has to remember which way round it goes.
          bare = substr(A["background"], 2)
          A["overlay"]      = "#f7" bare
          A["overlay_rgba"] = "#" bare "f7"

          # accents is a space-separated string because it is a list, and a
          # list is the one thing this flat format cannot hold. The JSON and
          # TOML consumers want it quoted and comma separated.
          n = split(A["accents"], acc, " ")
          json = ""
          for (i = 1; i <= n; i++) json = json (i > 1 ? ", " : "") "\"" acc[i] "\""
          A["accents_json"] = json

          # Hyprlang has no #rrggbb literal - it wants rgb(rrggbb) - so every
          # colour is also published without its hash.
          for (k in A) keys[++nk] = k
          for (i = 1; i <= nk; i++)
              if (A[keys[i]] ~ /^#[0-9a-fA-F]{6}$/)
                  A[keys[i] "_hex"] = substr(A[keys[i]], 2)

          for (k in A) {
              if (k !~ /^[A-Za-z0-9_-]+$/) {
                  printf "qs-theme: %s: bad key %s, ignored\n", theme, k > "/dev/stderr"
                  continue
              }
              printf "%s\t%s\n", k, A[k]
          }
      }
    ' "$file"
}

# ── Render ───────────────────────────────────────────────────────────────
# Substitute {{ key }} throughout one template. An unresolved placeholder is a
# typo'd key, and a config carrying a literal "{{ accent }}" is worse than no
# config at all, so it is a hard failure rather than a warning.
render() {
    tpl=$1
    out=$2
    sed -f "$sedscript" "$tpl" > "$out" || die "render failed: $tpl"
    if grep -q '{{' "$out"; then
        echo "qs-theme: unresolved placeholders in $(basename "$tpl"):" >&2
        grep -o '{{[^}]*}}' "$out" | sort -u >&2
        exit 1
    fi
}

# ── Wallpapers ───────────────────────────────────────────────────────────
# One glob or path per line, # comments and blanks ignored, ~ expanded.
#
# IFS is newline only for the loop below: word splitting happens before
# globbing, so a line with no metacharacters survives whole even when the path
# has spaces in it, while a glob's matches still each come out as their own
# field.
expand_wallpapers() {
    list=$THEME_DIR/themes/$1/wallpapers
    [ -r "$list" ] || return 0

    oldifs=$IFS
    IFS=$(printf '\n')
    while read -r line; do
        case $line in ''|\#*) continue ;; esac
        case $line in "~/"*) line=$HOME/${line#\~/} ;; esac
        for f in $line; do
            [ -f "$f" ] && printf '%s\n' "$f"
        done
    done < "$list"
    IFS=$oldifs
}

# Deal one wallpaper per enabled output, without repeats, through qs-wallpaper -
# the same path the picker and auto-wall use, so the per-monitor record stays
# truthful and the bar repaints from it.
#
# A theme with no list, or one whose files have all moved, changes the palette
# and leaves the wallpapers alone. Failing the whole switch over a missing
# image would be a worse trade.
deal_wallpapers() {
    pool=$(expand_wallpapers "$1" | shuf)
    total=$(printf '%s\n' "$pool" | grep -c .)
    [ "$total" -gt 0 ] || return 0
    [ -x "$WALLPAPER" ] || return 0

    outputs=$("$WALLPAPER" list 2>/dev/null |
              tr ',' '\n' | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')
    i=0
    for out in $outputs; do
        i=$((i + 1))
        file=$(printf '%s\n' "$pool" | sed -n "$(( (i - 1) % total + 1 ))p")
        "$WALLPAPER" set "$out" "$file" >/dev/null 2>&1 ||
            echo "qs-theme: could not set wallpaper on $out" >&2
    done
}

# ── Reload ───────────────────────────────────────────────────────────────
# Every one of these is a no-op when the app is not running, which is every X
# session and every TTY, so none of them is guarded by a session check.
# alacritty needs nothing: it watches its own imports.
reload_consumers() {
    pkill -USR2 -x ghostty 2>/dev/null
    command -v hyprctl >/dev/null && hyprctl reload >/dev/null 2>&1
    command -v makoctl >/dev/null && makoctl reload >/dev/null 2>&1
    # Emacs re-reads theme.name itself rather than being handed the name, so
    # this stays as stateless as the others. -a false is what keeps it a
    # no-op: with no server running emacsclient runs false and exits instead
    # of starting an Emacs. A pgrep guard would not do - the binary here is
    # emacs-pgtk, and the name differs again on the next machine.
    command -v emacsclient >/dev/null &&
        emacsclient -a false -e '(nl/qs-theme-sync)' >/dev/null 2>&1
    :
}

# ── Commands ─────────────────────────────────────────────────────────────

# Cycle order is whatever the glob gives, which is alphabetical. That is
# arbitrary but it is also self-maintaining: adding a theme directory puts it
# in the rotation with nothing else to edit, and there is exactly one place -
# here - that decides the order, so a keybind, the bar chip and the IPC handler
# cannot disagree about what comes next.
cmd_list() {
    for d in "$THEME_DIR"/themes/*/; do
        [ -r "$d/colors.toml" ] && basename "$d"
    done
}

# What the picker grid needs, in cycle order:
#
#   [{"name":"doomone","preview":"/path/to/a.webp","base":"#282c34",
#     "accents":["#51afef", ...]}, ...]
#
# The preview is the first wallpaper the theme owns - the same rule Omarchy
# uses, where any image in a theme's backgrounds/ folder represents it because
# they were all chosen to suit its palette. First rather than random so the
# tile a theme shows is the same one every time the picker opens.
#
# base and accents come along because a theme with no wallpapers still needs a
# tile, and its own colours are the honest thing to draw there. Resolving them
# here rather than reading colors.toml in QML keeps the cascade in one place.
cmd_previews() {
    printf '['
    first=1
    for name in $(cmd_list); do
        [ "$first" = 1 ] || printf ','
        first=0
        preview=$(expand_wallpapers "$name" | head -1)
        resolve "$name" | awk -F "$TAB" -v name="$name" -v preview="$preview" '
            $1 == "background"   { bg = $2 }
            $1 == "accents_json" { acc = $2 }
            END { printf "{\"name\":\"%s\",\"preview\":\"%s\",\"base\":\"%s\",\"accents\":[%s]}",
                         name, preview, bg, acc }
        '
    done
    printf ']\n'
}

cmd_cycle() {
    now=$(cmd_current)
    next=$(cmd_list | awk -v now="$now" '
        { t[NR] = $0; if ($0 == now) at = NR }
        END { print t[at % NR + 1] }
    ')
    [ -n "$next" ] || die "nothing to cycle to"
    cmd_set "$next"
}

cmd_current() {
    name=$(cat "$STATE/theme.name" 2>/dev/null)
    [ -n "$name" ] && [ -r "$THEME_DIR/themes/$name/colors.toml" ] || name=$DEFAULT_THEME
    echo "$name"
}

cmd_color() {
    key=$1
    [ -n "$key" ] || usage
    value=$(resolve "$(cmd_current)" | awk -F "$TAB" -v k="$key" '$1 == k { print $2; exit }')
    [ -n "$value" ] || value=$2
    [ -n "$value" ] || return 1
    echo "$value"
}

cmd_set() {
    name=$1
    [ -n "$name" ] || usage
    [ -r "$THEME_DIR/themes/$name/colors.toml" ] || die "no such theme: $name"

    work=${TMPDIR:-/tmp}/qs-theme.$$
    mkdir -p "$work" || exit 1
    trap 'rm -rf "$work"' EXIT INT TERM

    # Rendered whole into a scratch directory and moved into place only once
    # every template has come out clean, so a typo in one template cannot
    # leave half the desktop on the new theme and half on the old.
    sedscript=$work/subst.sed
    resolve "$name" |
        awk -F "$TAB" '{ printf "s|{{ *%s *}}|%s|g\n", $1, $2 }' > "$sedscript" ||
        exit 1
    [ -s "$sedscript" ] || die "resolved nothing for $name"

    for tpl in "$THEME_DIR"/templates/*.tpl; do
        [ -r "$tpl" ] || continue
        base=$(basename "$tpl" .tpl)
        render "$tpl" "$work/$base"
    done

    mkdir -p "$STATE" || exit 1
    for f in "$work"/*; do
        case $f in *subst.sed) continue ;; esac
        mv -- "$f" "$STATE/$(basename "$f")" || exit 1
    done
    printf '%s\n' "$name" > "$STATE/theme.name"

    # btm has no include directive and its config is not repo managed, so the
    # generated file IS the config.
    if [ -r "$STATE/bottom.toml" ]; then
        mkdir -p "$(dirname "$BOTTOM_CONFIG")" &&
            cp -- "$STATE/bottom.toml" "$BOTTOM_CONFIG"
    fi

    [ "$QS_THEME_DRY" = 1 ] && return 0

    deal_wallpapers "$name"
    reload_consumers
}

# ── Refresh ──────────────────────────────────────────────────────────────
# Bring the themes that track an upstream back level with it.
#
# Reporting is the default and writing is the flag, because the whole point of
# tracking upstream is that a refresh is not a decision anyone makes blind: an
# upstream author can repaint a theme between one commit and the next - akane
# went from mauve on navy to red on near-black in a single package - and a
# silent overwrite would land that on the desktop with no notice.

# The URL a theme was taken from: the first line of themes/<name>/upstream
# that is neither blank nor a comment.
upstream_url() {
    sed -e 's/^[ \t]*//' -e 's/[ \t]*$//' "$1" |
        grep -v -e '^#' -e '^$' | head -1
}

# An absolute path is fetched as itself. That is not a convenience for the
# command line - it is what lets the test suite exercise refresh end to end
# with no network.
fetch_upstream() {
    case $1 in
        /*)                 cat -- "$1" ;;
        http://*|https://*)
            if command -v curl >/dev/null 2>&1; then
                curl -sfL --max-time 30 "$1"
            elif command -v wget >/dev/null 2>&1; then
                wget -q -T 30 -O - "$1"
            else
                die "refresh needs curl or wget"
            fi ;;
        *)                  return 2 ;;
    esac
}

cmd_upstream_list() {
    for d in "$THEME_DIR"/themes/*/; do
        [ -r "$d/upstream" ] && [ -r "$d/colors.toml" ] && basename "$d"
    done
}

cmd_refresh() {
    write=0
    while [ $# -gt 0 ]; do
        case $1 in
            -w|--write) write=1; shift ;;
            --)         shift; break ;;
            -*)         usage ;;
            *)          break ;;
        esac
    done

    [ $# -gt 0 ] || set -- $(cmd_upstream_list)
    [ $# -gt 0 ] || die "no theme names an upstream"

    work=${TMPDIR:-/tmp}/qs-theme-refresh.$$
    mkdir -p "$work/vet/themes" || exit 1
    trap 'rm -rf "$work"' EXIT INT TERM

    moved=""
    drift=0
    broke=0
    for name in "$@"; do
        dir=$THEME_DIR/themes/$name
        [ -r "$dir/colors.toml" ] || die "no such theme: $name"
        if [ ! -r "$dir/upstream" ]; then
            echo "qs-theme: $name: tracks no upstream, skipped" >&2
            broke=1; continue
        fi
        url=$(upstream_url "$dir/upstream")
        if [ -z "$url" ]; then
            echo "qs-theme: $name: upstream names no URL" >&2
            broke=1; continue
        fi
        # Emptiness is checked as well as the exit status: a proxy or a
        # captive portal answers 200 with nothing, and truncating a live
        # theme to zero bytes is the one outcome worth being paranoid about.
        if ! fetch_upstream "$url" > "$work/fetched" || [ ! -s "$work/fetched" ]; then
            echo "qs-theme: $name: could not fetch $url" >&2
            broke=1; continue
        fi

        # The candidate is what upstream says now, followed by whatever this
        # repo has appended below the marker. The blank line is part of the
        # canonical form and is written rather than carried: the marker
        # itself is the first line sed keeps, so a blank line that had been
        # typed above it would be dropped here and the file would then report
        # drift on every run, for ever, over nothing.
        cp "$work/fetched" "$work/candidate" || exit 1
        if grep -q "^$OVERRIDE_MARK\$" "$dir/colors.toml"; then
            printf '\n' >> "$work/candidate"
            sed -n "/^$OVERRIDE_MARK\$/,\$p" "$dir/colors.toml" >> "$work/candidate"
        fi

        if cmp -s "$work/candidate" "$dir/colors.toml"; then
            echo "$name: up to date"
            continue
        fi

        # Put the candidate through the cascade before showing it, let alone
        # writing it. An upstream that has dropped a required key would
        # otherwise be reported as an ordinary diff and then break every
        # template the next time anything called set.
        rm -rf "$work/vet/themes/$name"
        mkdir -p "$work/vet/themes/$name" &&
            cp "$work/candidate" "$work/vet/themes/$name/colors.toml" || exit 1
        if ! ( THEME_DIR=$work/vet; resolve "$name" >/dev/null ); then
            echo "qs-theme: $name: upstream no longer resolves, left alone" >&2
            broke=1; continue
        fi

        drift=1
        echo "$name: differs from $url"
        diff -u "$dir/colors.toml" "$work/candidate" | tail -n +3
        if [ "$write" = 1 ]; then
            cp "$work/candidate" "$dir/colors.toml" || exit 1
            echo "$name: updated"
            moved="$moved $name"
        fi
    done

    # Nothing here re-renders: refresh changes what a theme is, and set is
    # what puts a theme on the screen. Saying so is better than guessing that
    # the user wanted the switch too.
    case " $moved " in
        *" $(cmd_current) "*)
            echo "the live theme moved - run: qs-theme set $(cmd_current)" ;;
    esac

    [ "$broke" = 0 ] || return 3
    [ "$write" = 1 ] && return 0
    [ "$drift" = 0 ]
}

# ── Install and remove ───────────────────────────────────────────────────
# Adding a theme is a change to whatever repository holds the theme directory,
# and is meant to be: colors.toml and the URL it tracks are version controlled,
# and only the images are not. That is the one way install differs from set,
# which deliberately writes nothing inside the theme directory at all - which
# is also why the themes are their own repository rather than part of the
# dotfiles tree that carries them, so a theme installed from a GUI cannot leave
# uncommitted files in a config repo.

# The theme name a package repository implies: omarchy-akane-theme is akane,
# delete-theme is delete. Both affixes are conventions rather than rules, so
# an explicit name always wins.
repo_theme_name() {
    n=${1##*/}
    n=${n%.git}
    n=${n#omarchy-}
    n=${n%-theme}
    printf '%s\n' "$n"
}

# The raw URL of a colors.toml on a branch, for the upstream file. Only the
# forges whose raw layout is known are handled; anything else installs fine
# and simply does not get tracked, which is better than writing a URL that
# refresh would fail on later.
raw_colors_url() {
    case $1 in
        https://github.com/*)
            printf 'https://raw.githubusercontent.com/%s/%s/colors.toml\n' \
                   "$(echo "${1#https://github.com/}" | sed 's/\.git$//')" "$2" ;;
        git@github.com:*)
            printf 'https://raw.githubusercontent.com/%s/%s/colors.toml\n' \
                   "$(echo "${1#git@github.com:}" | sed 's/\.git$//')" "$2" ;;
        *)  return 1 ;;
    esac
}

cmd_install() {
    url=$1
    [ -n "$url" ] || usage
    name=${2:-$(repo_theme_name "$url")}
    case $name in
        ''|*/*|.*) die "not a usable theme name: $name" ;;
    esac
    dir=$THEME_DIR/themes/$name
    [ -e "$dir" ] && die "$name is already installed - qs-theme refresh $name, or remove it first"
    command -v git >/dev/null 2>&1 || die "install needs git"

    work=${TMPDIR:-/tmp}/qs-theme-install.$$
    mkdir -p "$work" || exit 1
    trap 'rm -rf "$work"' EXIT INT TERM

    git clone --quiet --depth 1 -- "$url" "$work/pkg" ||
        die "could not clone $url"
    [ -r "$work/pkg/colors.toml" ] ||
        die "$url has no colors.toml at its root"

    # Resolved before anything is written, so a package in a format this
    # cascade cannot read is refused here rather than discovered the next
    # time something calls set.
    mkdir -p "$work/vet/themes/$name" &&
        cp "$work/pkg/colors.toml" "$work/vet/themes/$name/colors.toml" || exit 1
    ( THEME_DIR=$work/vet; resolve "$name" >/dev/null ) ||
        die "$url does not resolve as a theme"

    branch=$(git -C "$work/pkg" rev-parse --abbrev-ref HEAD 2>/dev/null)
    [ -n "$branch" ] && [ "$branch" != HEAD ] || branch=main

    mkdir -p "$dir" || exit 1
    cp "$work/pkg/colors.toml" "$dir/colors.toml" || exit 1
    if raw=$(raw_colors_url "$url" "$branch"); then
        printf '%s\n' "$raw" > "$dir/upstream"
    else
        echo "qs-theme: $name: no known raw URL for $url, so it will not be tracked" >&2
    fi

    # Backgrounds are copied out of the clone rather than referenced from it,
    # so nothing here depends on that checkout still existing. Prefixed with
    # the theme name because the library is flat per set and several packages
    # ship a 1.jpg.
    n=0
    if [ -d "$work/pkg/backgrounds" ]; then
        mkdir -p "$WALLPAPER_LIB/$name" || exit 1
        for f in "$work/pkg/backgrounds"/*; do
            [ -f "$f" ] || continue
            cp -- "$f" "$WALLPAPER_LIB/$name/$name-$(basename "$f")" || exit 1
            n=$((n + 1))
        done
    fi
    if [ "$n" -gt 0 ]; then
        {
            echo "# The $n backgrounds shipped with the upstream $name package,"
            echo "# copied out of its repo so nothing here depends on that clone."
            echo "$WALLPAPER_LIB/$name/$name-*" | sed "s|^$HOME/|~/|"
        } > "$dir/wallpapers"
    else
        echo "qs-theme: $name: the package ships no backgrounds/, so it has no wallpapers" >&2
    fi

    echo "$name: installed from $url ($n wallpapers)"
    echo "try it with: qs-theme set $name"
}

# ── Check ────────────────────────────────────────────────────────────────
# What a GUI asks before it offers a package: would install take this? The
# answer has to come from the guard install itself applies, or the browser
# would be holding a second opinion about what a theme is - so this fetches
# the one file install insists on and puts it through the same resolve, and
# refuses for the same two reasons in the same words.
#
# It fetches rather than clones. install needs the whole package because it
# copies the backgrounds out, but the verdict only ever turns on colors.toml,
# and a browser that shallow-cloned every package the cursor landed on would
# pull tens of megabytes to answer a question about a few kilobytes.
#
# Nothing is written anywhere. A question that installed themes by being
# asked would be worse than no question at all.
cmd_check() {
    url=$1
    [ -n "$url" ] || usage
    name=${2:-$(repo_theme_name "$url")}
    case $name in
        ''|*/*|.*) die "not a usable theme name: $name" ;;
    esac

    # HEAD is the ref rather than a branch: install learns the default branch
    # from its clone, and there is no clone here to learn one from. A forge
    # whose raw layout is unknown is not a verdict about the package - install
    # would still take it, it simply could not be tracked - so it is 5.
    raw=$(raw_colors_url "$url" HEAD) ||
        uncheckable "$url" "no known raw layout for that forge"
    command -v curl >/dev/null 2>&1 ||
        uncheckable "$url" "check needs curl"

    work=${TMPDIR:-/tmp}/qs-theme-check.$$
    mkdir -p "$work/vet/themes/$name" || exit 1
    trap 'rm -rf "$work"' EXIT INT TERM

    status=$(curl -sL --max-time 30 -o "$work/fetched" -w '%{http_code}' "$raw")
    case $status in
        200) ;;
        404) unusable "$url has no colors.toml at its root" ;;
        *)   uncheckable "$url" "the fetch answered ${status:-nothing}" ;;
    esac
    # Emptiness is checked as well as the status, for the reason refresh
    # checks it: a proxy or a captive portal answers 200 with nothing, and
    # nothing does not resolve, so believing the status here would report a
    # perfectly good package as broken every time the wifi was captive.
    [ -s "$work/fetched" ] ||
        uncheckable "$url" "the fetch came back empty"

    cp "$work/fetched" "$work/vet/themes/$name/colors.toml" || exit 1
    ( THEME_DIR=$work/vet; resolve "$name" >/dev/null ) ||
        unusable "$url does not resolve as a theme"

    echo "$name: installable"
}

cmd_remove() {
    name=$1
    [ -n "$name" ] || usage
    dir=$THEME_DIR/themes/$name
    [ -d "$dir" ] || die "no such theme: $name"
    [ "$name" = "$DEFAULT_THEME" ] &&
        die "$name is the fallback theme, which has to stay"
    [ "$name" = "$(cmd_current)" ] &&
        die "$name is the live theme - switch away from it first"

    rm -rf "$dir" || exit 1
    echo "$name: removed"
    [ -d "$WALLPAPER_LIB/$name" ] &&
        echo "its wallpapers are left in $WALLPAPER_LIB/$name"
    :
}

# ── Preview images ───────────────────────────────────────────────────────
# What a theme looks like is a picture of a desktop running it, not one of its
# wallpapers: two themes can ship the same photograph, and neither of them
# shows the palette. An Omarchy package publishes exactly that picture, a
# preview.png beside the colors.toml, and the catalog behind the manager's
# browse key already draws it - so the installed grid can be made to show the
# same kind of thing.
#
# A theme's screenshot is the preview.png sibling of the URL in
# themes/<name>/upstream, the derivation refresh already uses to re-fetch the
# palette. Nothing therefore has to record a second address per theme, and a
# theme that tracks no upstream has no screenshot by construction - it gets a
# generated palette card instead.

# The address of the screenshot, given the address of the palette. Absolute
# paths are derived the same way, which is what lets the test suite exercise
# this with no network, exactly as fetch_upstream does for refresh.
preview_image_url() {
    case $1 in
        */colors.toml) printf '%s/preview.png\n' "${1%/colors.toml}" ;;
        *)             return 1 ;;
    esac
}

have_fetcher() {
    command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1
}

# Fetch one theme's screenshot, unless it is already cached. force refetches.
#
# A cached screenshot is kept indefinitely: an upstream author repaints a
# palette far more often than they reshoot the desktop, and --force is there
# for when they do. A failed fetch leaves nothing at all - no partial file and
# no marker saying it was tried - so a theme that was unreachable this time is
# retried on the next run rather than left with a card for ever.
cache_preview_image() {
    name=$1
    force=$2
    dest=$PREVIEW_IMAGE_DIR/$name.png
    [ "$force" = 1 ] || [ ! -s "$dest" ] || return 0

    [ -r "$THEME_DIR/themes/$name/upstream" ] || return 1
    url=$(preview_image_url "$(upstream_url "$THEME_DIR/themes/$name/upstream")") ||
        return 1
    case $url in
        http://*|https://*) have_fetcher || return 1 ;;
    esac

    mkdir -p "$PREVIEW_IMAGE_DIR" || return 1
    part=$dest.part.$$
    if fetch_upstream "$url" > "$part" 2>/dev/null && [ -s "$part" ]; then
        mv -f -- "$part" "$dest" && return 0
    fi
    rm -f -- "$part"
    return 1
}

# Every tracked theme, in one pass. A theme that has no screenshot upstream is
# not an error and does not stop the others: seven of them are like that, and
# what they get instead is a card built from the palette itself.
cache_preview_images() {
    force=$1
    for name in $(cmd_upstream_list); do
        cache_preview_image "$name" "$force" || :
    done
}


# ── The palette card ─────────────────────────────────────────────────────
# What a theme with no upstream screenshot shows instead: its own background
# as the ground, its name across it and a row of its accents beneath. Drawn at
# the screenshots' 1800x1012 so a grid of the two kinds is one size.
#
# Built from the resolved palette rather than colors.toml, so a theme carrying
# local overrides shows the colours actually in force - which is a thing an
# upstream screenshot could not show even if there were one.
CARD_WIDTH=1800
CARD_HEIGHT=1012

# ImageMagick 7 renames the command; 6 is still what several of these machines
# have. Either draws this.
run_magick() {
    if command -v magick >/dev/null 2>&1; then
        magick "$@"
    else
        convert "$@"
    fi
}

have_magick() {
    command -v magick >/dev/null 2>&1 || command -v convert >/dev/null 2>&1
}

# Draw one theme's card, unless the one on disk is already current. force
# redraws it anyway.
#
# Current means newer than the colors.toml it was drawn from, which is the
# only input: an edited palette - an override appended, a refresh applied -
# invalidates that theme's card and nothing else. Screenshots are cached by
# existence because their input is upstream and unwatchable; a card's input is
# a file right here, so it can be watched.
cache_preview_card() {
    name=$1
    force=$2
    colors=$THEME_DIR/themes/$name/colors.toml
    [ -r "$colors" ] || return 1
    dest=$PREVIEW_CARD_DIR/$name.png
    if [ "$force" != 1 ] && [ -s "$dest" ] && [ ! "$colors" -nt "$dest" ]; then
        return 0
    fi
    have_magick || return 1

    palette=$(resolve "$name") || return 1
    bg=$(printf '%s\n' "$palette" | awk -F "$TAB" '$1 == "background" { print $2; exit }')
    fg=$(printf '%s\n' "$palette" | awk -F "$TAB" '$1 == "foreground" { print $2; exit }')
    accents=$(printf '%s\n' "$palette" | awk -F "$TAB" '$1 == "accents" { print $2; exit }')
    [ -n "$bg" ] && [ -n "$fg" ] || return 1

    # The swatch row is centred in a 1440 wide band, and a swatch is 260 wide
    # at most: five accents sit at that width, and a palette that publishes
    # more gets narrower ones rather than a row running off the card.
    n=0
    for c in $accents; do n=$((n + 1)); done
    band=1440
    gap=40
    if [ "$n" -gt 0 ]; then
        swatch=$(((band - (n - 1) * gap) / n))
        [ "$swatch" -le 260 ] || swatch=260
        row=$((n * swatch + (n - 1) * gap))
        x=$(((CARD_WIDTH - row) / 2))
    fi

    set -- -size "${CARD_WIDTH}x${CARD_HEIGHT}" "xc:$bg" -gravity NorthWest
    for c in $accents; do
        set -- "$@" -fill "$c" \
            -draw "roundrectangle $x,620 $((x + swatch)),760 24,24"
        x=$((x + swatch + gap))
    done
    # label: rather than a pointsize, so the longest theme name is scaled to
    # the band instead of being drawn off the edge of it.
    set -- "$@" \
        \( -background none -fill "$fg" -size "${band}x200" \
           -gravity center "label:$name" \) \
        -gravity North -geometry +0+300 -composite

    mkdir -p "$PREVIEW_CARD_DIR" || return 1
    part=$dest.part.$$
    if run_magick "$@" "png:$part" 2>/dev/null && [ -s "$part" ]; then
        mv -f -- "$part" "$dest" && return 0
    fi
    rm -f -- "$part"
    return 1
}

# A card for every theme that has no cached screenshot. Called after the
# screenshots, so a theme that has just been fetched is not also drawn.
cache_preview_cards() {
    force=$1
    for name in $(cmd_list); do
        [ -s "$PREVIEW_IMAGE_DIR/$name.png" ] && continue
        cache_preview_card "$name" "$force" || :
    done
}

# ── The theme manager's two views ────────────────────────────────────────
# Both exist so the picker has no second opinion about what a theme is. It
# could scan the theme directory itself, and then a theme installed while it
# was open, or one whose upstream file it did not know to look for, would put
# the grid and this script into disagreement about the same question.

# The reverse of raw_colors_url, for the inventory below: a tracked theme
# knows the file it came from, and what the manager wants to show is the
# repository that file is in.
repo_url_for_raw() {
    case $1 in
        https://raw.githubusercontent.com/*)
            printf 'https://github.com/%s\n' \
                   "$(echo "${1#https://raw.githubusercontent.com/}" | cut -d/ -f1,2)" ;;
        *)  : ;;
    esac
}

# user is a theme that came from a package and can be removed and installed
# again; stock is one authored here, which cannot be got back once dropped.
# That is the distinction the manager needs, and tracking an upstream is
# exactly what tells the two apart.
cmd_inventory() {
    for name in $(cmd_list); do
        if [ -r "$THEME_DIR/themes/$name/upstream" ]; then
            printf 'user\t%s\t%s\n' "$name" \
                   "$(repo_url_for_raw "$(upstream_url "$THEME_DIR/themes/$name/upstream")")"
        else
            printf 'stock\t%s\t\n' "$name"
        fi
    done
}

# The picker grid draws a directory of image files, so a theme has to look
# like one to appear in it. What it looks like is its own desktop screenshot
# where upstream publishes one and a palette card where it does not - never
# one of its wallpapers, which is a photograph two themes can share and shows
# the palette of neither.
#
# Symlinks rather than copies: both sources are files in this cache already,
# and the grid thumbnails them anyway. The stem is the theme name and the
# extension is always .png, because that is what both caches hold - and the
# stem is what ThemeManagerModel.themeNameForPath reads the theme back out of.
#
# Rebuilt from empty every time. A theme that has been removed or renamed
# would otherwise leave a link behind that still resolves, and the grid would
# go on offering a theme that is gone.
cmd_preview_links() {
    force=0
    offline=0
    while :; do
        case $1 in
            --force)   force=1; shift ;;
            --offline) offline=1; shift ;;
            -?*)       usage ;;
            *)         break ;;
        esac
    done
    dir=${1:-$CACHE_DIR/previews}

    # Fill the caches before linking over them, screenshots first: a card is
    # drawn only for a theme that has no screenshot, so the other order would
    # draw one and then not use it.
    [ "$offline" = 1 ] || cache_preview_images "$force"
    cache_preview_cards "$force"

    mkdir -p "$dir" || exit 1
    for f in "$dir"/*; do
        { [ -L "$f" ] || [ -f "$f" ]; } && rm -f -- "$f"
    done
    for name in $(cmd_list); do
        img=$PREVIEW_IMAGE_DIR/$name.png
        [ -s "$img" ] || img=$PREVIEW_CARD_DIR/$name.png
        # Neither: upstream publishes no screenshot and there is no
        # ImageMagick here to draw the card. Leave the theme out of the grid
        # rather than link it to nothing.
        [ -s "$img" ] || continue
        ln -s -- "$img" "$dir/$name.png" || exit 1
    done
    printf '%s\n' "$dir"
}
case $1 in
    set)     shift; cmd_set "$@" ;;
    cycle)   cmd_cycle ;;
    wallpapers) shift; expand_wallpapers "${1:-$(cmd_current)}" ;;
    previews) cmd_previews ;;
    list)    cmd_list ;;
    current) cmd_current ;;
    color)   shift; cmd_color "$@" ;;
    refresh) shift; cmd_refresh "$@" ;;
    install) shift; cmd_install "$@" ;;
    remove)  shift; cmd_remove "$@" ;;
    check)   shift; cmd_check "$@" ;;
    inventory) cmd_inventory ;;
    preview-links) shift; cmd_preview_links "$@" ;;
    *)       usage ;;
esac
