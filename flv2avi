#!/usr/bin/env bash
set -euo pipefail

usage() {
    echo "Usage: $(basename "$0") FILE.flv [FILE2.flv ...]"
    echo "Convert FLV files to AVI using ffmpeg."
}

if [ $# -eq 0 ]; then
    usage >&2
    exit 1
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
    echo "ERROR: ffmpeg is required" >&2
    exit 127
fi

for infile in "$@"; do
    if [ ! -f "$infile" ]; then
        echo "Skipping missing file: $infile" >&2
        continue
    fi

    outfile="${infile%.*}.avi"
    ffmpeg -hide_banner -i "$infile" \
        -c:v mpeg4 -q:v 4 \
        -c:a libmp3lame -q:a 2 \
        "$outfile"
done
